---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import OrnamentTiles from "../components/OrnamentTiles.astro";
import { SITE } from "../data/client";
import { EMAIL_DECODER_JS } from "../lib/email";
import "../css/reset.css";
import "../css/global.css";
import "../css/index.css";

interface Props {
  title: string;
  path?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterDescription?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const props = Astro.props;
---

<html lang={SITE.locale}>
  <head>
    <BaseHead {...props}>
      <slot name="head" slot="head" />
    </BaseHead>
    <OrnamentTiles />
  </head>
  <body>
    <slot name="header" />

    <main>
      <slot />
    </main>

    <Footer />

    {/* ~250 bytes, inline and parse-time, so the address is never
        plaintext in the HTML and no request is made. docs/performance.md */}
    <script is:inline set:html={EMAIL_DECODER_JS} />
  </body>
</html>
