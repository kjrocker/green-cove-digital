---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";
import SpotBand from "../components/SpotBand.astro";
import Section from "../components/Section.astro";
import { SITE, BUSINESS } from "../data/client";

const hasError = Astro.url.searchParams.get("error") === "1";---

<BaseLayout
  title={`Contact — ${SITE.title}`}
  path="/contact"
  ogTitle={`Contact ${SITE.title}`}
  description={`Get in touch with ${SITE.title} to talk about a website for your business. Working remotely with small businesses across the US.`}
>
  <Hero slot="header" title="Get in Touch">
    <p>
      Ready to talk about a website for your business — a first one or a
      better one? Tell me a little about what you do and I'll get back to
      you within one business day.
    </p>
  </Hero>

  <Section ornament>
    <h2>Send a Message</h2>
    <p>
      <strong>Email:</strong>
      <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
    </p>
    <p>
      I work remotely with businesses anywhere in the US; calls, previews and
      updates all happen online.
    </p>
    <Grid layout="50-50">
      <form
        class="flow contact-form"
        action="/api/contact"
        method="POST"
      >
        {
          hasError && (
            <p class="form-error" role="alert">
              Something went wrong sending your message. Please try again,
              or email <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a> directly.
            </p>
          )
        }
        <div class="form-field flow" data-flow="sm">
          <label for="name">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
          />
        </div>
        <div class="form-field flow" data-flow="sm">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
          />
        </div>
        <div class="form-field flow" data-flow="sm">
          <label for="business">Business name <span class="optional">(optional)</span></label>
          <input
            type="text"
            id="business"
            name="business"
            autocomplete="organization"
          />
        </div>
        <div class="form-field flow" data-flow="sm">
          <label for="website">Current website, if you have one <span class="optional">(optional)</span></label>
          <input
            type="url"
            id="website"
            name="website"
            inputmode="url"
            placeholder="https://"
            autocomplete="url"
          />
        </div>
        <div class="form-field flow" data-flow="sm">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required
          ></textarea>
        </div>
        <div class="honeypot" aria-hidden="true">
          <label for="company">Company (leave blank)</label>
          <input
            type="text"
            id="company"
            name="company"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <button type="submit">Send Message</button>
      </form>
    </Grid>
  </Section>

  <!--
    Manual deviation from the section rhythm: this is the last band before the
    footer, so its bottom curve would otherwise land right against the footer's
    top curve. The extra margin gives the white gap between them some room.
  -->
  <div class="next-steps">
    <SpotBand>
      <h2>What Happens Next</h2>
      <p>
        I'll reply within one business day with a few questions about your
        business and what you need the site to do. From there we'll set up a
        short call, and if it's a fit I'll send a written summary of scope,
        timeline, price and terms. No obligation, and nothing to pay until
        you've read the summary and said yes.
      </p>
    </SpotBand>
  </div>
</BaseLayout>

<style>
  .next-steps {
    margin-block-end: var(--space-l-xl);
  }

  .contact-form {
    max-width: 50ch;
  }

  .form-field {
    display: flex;
    flex-direction: column;
  }

  .form-field label {
    font-weight: 700;
    font-size: var(--size-step-0);
  }

  .form-field .optional {
    font-weight: 400;
    opacity: 0.75;
  }

  .form-field input,
  .form-field textarea {
    border: 2px solid var(--color-dark);
    border-radius: calc(var(--border-radius) / 2);
    font-family: var(--font-base);
    font-size: var(--size-step-0);
    padding: var(--space-xs);
    max-width: 100%;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color: var(--color-primary);
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  button[type="submit"] {
    background: var(--color-primary);
    border: none;
    border-radius: calc(var(--border-radius) / 2);
    color: var(--color-light);
    cursor: pointer;
    font-family: var(--font-base);
    font-size: var(--size-step-1);
    font-weight: 700;
    padding: var(--space-xs) var(--space-m);
  }

  button[type="submit"]:hover {
    opacity: 0.9;
  }

  .form-error {
    background: var(--color-secondary);
    color: var(--color-dark);
    padding: var(--space-xs) var(--space-s);
    border-radius: calc(var(--border-radius) / 2);
    font-size: var(--size-step-0);
  }

  .form-error a {
    color: inherit;
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
