---
import Curve from "../components/Curve.astro";
import Footer from "../components/Footer.astro";
import "../css/reset.css";
import "../css/global.css";
import "../css/index.css";
import Navigation from "../components/Navigation.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Starburst Digital builds affordable, custom websites for small businesses in Charlotte, NC and beyond. Professional web development and technical consulting from an experienced software engineer."
    />
    <meta
      property="og:title"
      content="Affordable Small Business Websites | Starburst Digital"
    />
    <meta
      property="og:description"
      content="Custom websites for small businesses starting at $150/month. Professional web development and technical consulting in Charlotte, NC."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content="Affordable Small Business Websites | Starburst Digital"
    />
    <meta
      name="twitter:description"
      content="Custom websites for small businesses starting at $150/month. Professional web development and technical consulting in Charlotte, NC."
    />
    <title>Affordable Small Business Websites | Starburst Digital</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        name: "Starburst Digital",
        description:
          "Custom web development and technical consulting for small businesses.",
        url: "https://starburstdigital.com",
        email: "hello@starburstdigital.com",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Charlotte",
          addressRegion: "NC",
          addressCountry: "US",
        },
        founder: {
          "@type": "Person",
          name: "Kevin",
        },
        serviceType: ["Web Development", "Technical Consulting"],
        priceRange: "$150/month",
      })}
    />
  </head>
  <body>
    <header class="flow section spot-color-primary">
      <h1 class="wrapper ml-md-sm mt-l-xl big">Starburst Digital</h1>
      <nav class="" style="padding-top:1px;padding-bottom:1px;">
        <Navigation />
      </nav>
    </header>

    <main>
      <div class="section spot-color-primary">
        <div class="section__inner">
          <div class="wrapper flow region">
            <h1>
              A Professional Website Your Small Business Can Actually Afford
            </h1>
            <p>
              Custom websites starting at $150/month — no huge upfront costs, no
              cookie-cutter templates. Just a fast, professional web presence
              built by a real software engineer from Charlotte, NC.
            </p>
            <p>
              <a href="/contact">Get a Free Website Quote</a>
            </p>
          </div>
        </div>
        <Curve />
      </div>

      <article class="region wrapper flow">
        <h2>Why Work With Me?</h2>
        <ul class="grid" data-layout="50-50" role="list">
          <li class="card flow">
            <h3>Human Expertise</h3>
            <p>
              I'm a real software engineer with real experience — not a template
              factory or AI content mill. Every line of code is written with
              your business in mind.
            </p>
            <p>
              When you work with me, you're talking directly to the person
              building your site. No account managers, no outsourced development
              teams, no chatbots. Just straightforward communication and
              technical know-how you can rely on.
            </p>
          </li>
          <li class="card flow">
            <h3>Built for Speed</h3>
            <p>
              Every site I build loads in under a second. Fast sites rank better
              on Google, convert more visitors, and cost less to host.
            </p>
            <p>
              <a href="/services/small-business"
                >Learn more about my approach to performance</a
              >
            </p>
          </li>
          <li class="card flow">
            <h3>Built for Mobile</h3>
            <p>
              Over 60% of web traffic comes from phones. Every site I build is
              designed mobile-first — fast, easy to navigate, and optimized for
              how your customers actually browse.
            </p>
            <p>
              No pinching and zooming. No tiny buttons. Just a site that works
              perfectly on every screen size.
            </p>
          </li>
          <li class="card flow">
            <h3>No Vendor Lock-In</h3>
            <p>
              Your content, your domain, your data — it all stays yours. Unlike
              Squarespace or Wix, you're not trapped in a proprietary platform
              that controls your business.
            </p>
            <p>
              I build sites on standard web technologies, which means your
              content is portable and you're not subject to arbitrary price
              hikes, forced feature restrictions, or platform policy changes
              that could hurt your business overnight.
            </p>
            <p>
              If your needs change or you want to move in a different direction,
              you won't have to rebuild from scratch. Your digital presence is
              yours to control.
            </p>
          </li>
        </ul>
      </article>

      <div class="section spot-color-secondary">
        <Curve />
        <div class="section__inner">
          <article class="flow region wrapper">
            <h2>Experience You Can Trust</h2>
            <p>
              I've spent years building software that people depend on — from
              mission-critical systems used by first responders to real estate
              management platforms and marketing analytics tools. I bring that
              same level of reliability and attention to detail to every small
              business website I create.
            </p>
            <p>
              <a href="/about">Learn more about my background</a>
            </p>
          </article>
        </div>
        <Curve />
      </div>

      <article class="flow region wrapper">
        <h2>Services</h2>
        <div class="grid" data-layout="50-50">
          <div class="flow card" data-flow="sm">
            <h3>
              <a href="/services/small-business">Small Business Websites</a>
            </h3>
            <p>
              A professional website designed specifically for your business. No
              templates, no bloat — just clean, fast, and effective web design
              that helps you get found and get customers.
            </p>
            <p>
              <strong>Starting at $150/month</strong> with zero down payment.
            </p>
            <p><strong>What's Included:</strong></p>
            <ul class="flow" data-flow="sm">
              <li>Custom branded website design</li>
              <li>Domain name management</li>
              <li>Responsive mobile-friendly design</li>
              <li>Content management system</li>
              <li>Basic SEO optimization</li>
              <li>Hosting and maintenance</li>
              <li>Regular updates and security patches</li>
              <li>Translation services (available for an additional fee)</li>
            </ul>
          </div>

          <div class="flow card" data-flow="sm">
            <h3><a href="/services/consulting">Technical Consulting</a></h3>
            <p>
              Strategic guidance on technical decisions, platform evaluation,
              code review, and architecture planning. Hourly and project-based
              engagements that save you from costly mistakes.
            </p>
            <p>
              <strong>Starting at $120/hour.</strong> Weekly and project rates available.
            </p>
            <p><strong>What's Included:</strong></p>
            <ul class="flow" data-flow="sm">
              <li>Full access to my expertise and experience</li>
              <li>Strategic planning and recommendations</li>
              <li>Technology and platform guidance</li>
              <li>Ongoing support and advice</li>
            </ul>
          </div>
        </div>
      </article>

      <article class="flow region wrapper">
        <h2>Ready to Get Started?</h2>
        <p>
          Let's talk about your project. I'll give you straight answers, honest
          timelines, and a plan that actually fits your budget.
        </p>
        <p>
          <a href="/contact">Get a Free Website Quote</a>
        </p>
      </article>
    </main>

    <Footer />
  </body>
</html>
