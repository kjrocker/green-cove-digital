---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import Grid from "../components/Grid.astro";
import SpotBand from "../components/SpotBand.astro";
import Section from "../components/Section.astro";
import { SITE, BUSINESS, PERSON } from "../data/client";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: BUSINESS.name,
  description:
    "Custom small business websites for a flat monthly price — design, hosting, maintenance and SEO included.",
  url: SITE.url,
  email: BUSINESS.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.state,
    addressCountry: "US",
  },
  founder: {
    "@type": "Person",
    name: PERSON.fullName,
  },
  serviceType: ["Web Design", "Web Development"],
  areaServed: [
    {
      "@type": "City",
      name: BUSINESS.address.city,
    },
    {
      "@type": "Country",
      name: "US",
    },
  ],
  priceRange: "$150/month",
};
---

<BaseLayout
  title={`Small Business Websites in ${BUSINESS.address.city}, ${BUSINESS.address.state} — $150/Month, $0 Down | ${SITE.title}`}
  path="/"
  description={`Custom websites for small businesses in ${BUSINESS.address.city}, ${BUSINESS.address.state} and beyond. $150/month, zero down — design, hosting, maintenance and local SEO included. Built by hand by a senior software engineer, not a template.`}
  ogDescription={`Custom small business websites from ${BUSINESS.address.city}, ${BUSINESS.address.state}. $150/month, $0 down, everything included — built by a senior engineer, not a page builder.`}
  jsonLd={jsonLd}
>
  <Hero slot="header" title="Websites for Small Businesses, Built by a Real Engineer" brandSize="hero">
    <p>
      A custom site for your {BUSINESS.address.city} business — designed,
      built, hosted and looked after by one experienced engineer. $150 a
      month, nothing down, twelve-month minimum once it's live.
    </p>
    <div class="cluster">
      <a href="/contact">Get a Free Quote</a>
      <a href="/services/small-business">See What's Included</a>
    </div>
  </Hero>

  <Section ornament>
    <h2>Sound Familiar?</h2>
    <Grid as="ul" layout="50-50" role="list">
      <Card as="li">
        <h3>"We have a website, but nobody finds it."</h3>
        <p>
          It's slow, it's not built for phones, and Google has quietly
          stopped sending people to it. Most template sites are like this —
          the builder gets you online, but not into search results.
        </p>
      </Card>
      <Card as="li">
        <h3>"An agency quoted us five figures."</h3>
        <p>
          A big up-front bill for a site that's out of date in a year, plus
          a maintenance contract on top. Great for the agency. Hard to
          justify for a five-person business.
        </p>
      </Card>
      <Card as="li">
        <h3>"I built it myself and I hate touching it."</h3>
        <p>
          Wix or Squarespace got you started, but every change is a
          weekend, the monthly fee keeps creeping up, and you're not sure
          who actually owns any of it.
        </p>
      </Card>
      <Card as="li">
        <h3>"Our web guy disappeared."</h3>
        <p>
          The freelancer who built it moved on, the login is on a laptop
          nobody has, and the last update was three years ago. You need
          someone who'll still pick up the phone.
        </p>
      </Card>
    </Grid>
  </Section>

  <SpotBand>
    <h2>One Flat Price. Everything Included.</h2>
    <p>
      <strong>$150 a month. $0 down.</strong> That covers a custom design,
      professional, search-optimized content, hosting, your domain,
      security updates, ongoing changes, and the local-search groundwork
      that gets you found. No surprise invoices and no separate maintenance
      plan.
    </p>
    <p>
      $0 down means there's no lump sum up front — the first month's $150 is
      what starts the work. The commitment is <strong>twelve months, and it
      starts the day the site goes live</strong> — building the site is weeks of work,
      and the first year of subscription is what pays for it. After that
      you're month to month, cancel with 30 days' notice. If you'd rather pay
      for the build once and own it outright,
      <a href="/services/small-business#own-it">that's an option too</a>.
    </p>
    <p>
      For comparison: a template on Squarespace costs $33 a month before
      you've paid anyone to set it up, and a typical agency build starts
      around $5,000 up front — before hosting or a single change. Three
      years with me is $5,400, with hosting and every update already in.
    </p>
    <p>
      <a href="/services/small-business">Full pricing and what's included</a>
    </p>
  </SpotBand>

  <Section>
    <h2>Why Work With Me?</h2>
    <Grid as="ul" layout="50-50" role="list">
      <Card as="li">
        <h3>One Person, Start to Finish</h3>
        <p>
          You talk to the person who designs and builds your site. No account
          manager, no handoff. I've spent ten years building software that
          first responders and real estate firms rely on, and I bring the same
          care to a five-page site for a plumber.
        </p>
      </Card>
      <Card as="li">
        <h3>Fast Enough to Rank</h3>
        <p>
          This site scores 100 on Google Lighthouse. Every site I build
          hits the same bar, because speed is a ranking factor and a
          conversion factor — people leave slow sites before they load.
        </p>
      </Card>
      <Card as="li">
        <h3>Built for Phones First</h3>
        <p>
          Most of your customers will find you on a phone. I design for
          small screens first — big tap targets, readable type, tap-to-call
          — and scale up from there.
        </p>
      </Card>
      <Card as="li">
        <h3>Your Domain, Your Content, Your Data</h3>
        <p>
          The domain is registered in your name, and every word and file you
          write or send me stays yours. No platform is holding your business's
          identity. The subscription covers the site I build and run, and
          nothing else.
        </p>
      </Card>
    </Grid>
  </Section>

  <SpotBand>
    <h2>How It Works</h2>
    <p>
      <strong>1. A short call.</strong> You tell me about your business, who
      your customers are, and what you want the site to do. I'll tell you
      what I'd build and how long it'll take — usually two to four weeks.
    </p>
    <p>
      <strong>2. I build it, you review it.</strong> Professional,
      search-optimized content is written from our conversation — you don't
      have to write your own website — and the design is built around your
      brand, or I help you sort one out. You get a private preview link and we
      go back and forth until it's right.
    </p>
    <p>
      <strong>3. Launch, then keep going.</strong> The site goes live on your
      domain. From then on you email me changes — new hours, a new service,
      a seasonal special — and they're done. Hosting, backups, and security
      updates are handled without you thinking about them.
    </p>
  </SpotBand>

  <Section>
    <h2>Who This Is For</h2>
    <p>
      Local service businesses, shops, restaurants, and professional
      practices in {BUSINESS.address.city} and anywhere else — businesses
      that need a professional site that gets found and turns visitors into
      calls, without an in-house marketing team.
    </p>
    <Grid layout="50-50">
      <Card data-flow="sm">
        <h3>A good fit if you…</h3>
        <ul class="flow" data-flow="sm">
          <li>Want a site that ranks locally and works on every phone</li>
          <li>Prefer a predictable monthly bill to a big up-front invoice</li>
          <li>Would rather email one person than learn a page builder</li>
          <li>Need it live in weeks, not months</li>
        </ul>
      </Card>
      <Card data-flow="sm">
        <h3>Probably not a fit if you…</h3>
        <ul class="flow" data-flow="sm">
          <li>Need a large e-commerce store with thousands of products</li>
          <li>Want a custom web application, not a marketing site</li>
          <li>Can't commit to twelve months once the site is live — a one-time build has no term</li>
          <li>Are looking for the cheapest possible option — a $0 builder is cheaper</li>
        </ul>
        <p>
          <a href="/services/small-business#faq">More questions answered here</a>
        </p>
      </Card>
    </Grid>
  </Section>

  <Section>
    <h2>Ready to Get Started?</h2>
    <p>
      Tell me about your business and I'll tell you what a site would look
      like, how long it'll take, and what it costs. Nothing to sign and
      nothing to pay for the call.
    </p>
    <div class="cluster">
      <a href="/contact">Get a Free Website Quote</a>
    </div>
  </Section>
</BaseLayout>
