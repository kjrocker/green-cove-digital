---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Card from "../components/Card.astro";
import Grid from "../components/Grid.astro";
import SpotBand from "../components/SpotBand.astro";
import Section from "../components/Section.astro";
import { SITE, BUSINESS, PERSON } from "../data/client";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: BUSINESS.name,
  description:
    "Custom web development and technical consulting for small businesses.",
  url: SITE.url,
  email: BUSINESS.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.state,
    addressCountry: "US",
  },
  founder: {
    "@type": "Person",
    name: PERSON.firstName,
  },
  serviceType: ["Web Development", "Technical Consulting"],
  priceRange: "$150/month",
};
---

<BaseLayout
  title={`Custom Web Development & Technical Consulting | ${SITE.title}`}
  path="/"
  description={`Custom web development and TypeScript/PostgreSQL consulting from an experienced software engineer in ${BUSINESS.address.city}, ${BUSINESS.address.state}. Small business websites starting at $150/month. Monorepo architecture and database consulting starting at $120/hour.`}
  ogDescription={`Custom web development and TypeScript/PostgreSQL consulting in ${BUSINESS.address.city}, ${BUSINESS.address.state}. Small business websites from $150/month. Technical consulting from $120/hour.`}
  jsonLd={jsonLd}
>
  <Hero slot="header" title="Software Engineering for Businesses That Need It Done Right" brandAs="h1">
    <p>
      I'm {PERSON.firstName}, a software engineer in {
        BUSINESS.address.city
      }, {BUSINESS.address.state}. I build custom websites for small
      businesses and consult on TypeScript monorepos and PostgreSQL for
      engineering teams.
    </p>
    <div class="cluster">
      <a href="/services/small-business">I need a website</a>
      <a href="/services/consulting">I need technical consulting</a>
    </div>
  </Hero>

  <Section>
    <h2>Why Work With Me?</h2>
    <Grid as="ul" layout="50-50" role="list">
      <Card as="li">
        <h3>One Person, Start to Finish</h3>
        <p>
          You talk directly to the person writing your code. I've built
          mission-critical dispatch software for first responders, real
          estate platforms, and marketing analytics tools — and I bring that
          same rigor to a five-page small business site.
        </p>
      </Card>
      <Card as="li">
        <h3>Sub-Second Load Times</h3>
        <p>
          This site scores 100 on Google Lighthouse. Every site I build hits
          the same bar. Faster pages rank higher, convert better, and cost
          less to host.
        </p>
        <p>
          <a href="/services/small-business"
            >Learn more about my approach to performance</a
          >
        </p>
      </Card>
      <Card as="li">
        <h3>Mobile-First by Default</h3>
        <p>
          Over 60% of web traffic comes from phones. I design for small
          screens first and scale up — large tap targets, readable type, and
          layouts that reflow cleanly.
        </p>
      </Card>
      <Card as="li">
        <h3>You Own Everything</h3>
        <p>
          Your content, your domain, your data. I build on open web
          standards, so you're never locked into a proprietary platform. If
          you outgrow me, you take your site with you — no rebuild required.
        </p>
      </Card>
    </Grid>
  </Section>

  <SpotBand>
    <h2>10+ Years of Professional Engineering</h2>
    <p>
      I've spent my career building software that teams depend on —
      dispatch systems for first responders, real estate platforms,
      marketing analytics tools. My deep specialties are TypeScript
      monorepos (Turborepo, Nx, pnpm workspaces) and PostgreSQL (schema
      design, query optimization, migration planning).
    </p>
    <p>
      <a href="/about">Learn more about my background</a>
    </p>
  </SpotBand>

  <Section>
    <h2>Services</h2>
    <Grid layout="50-50">
      <Card data-flow="sm">
        <h3>
          <a href="/services/small-business">Small Business Websites</a>
        </h3>
        <p>
          A custom website designed for your business — not a theme with
          your logo swapped in. Fast, mobile-friendly, and built to rank in
          local search.
        </p>
        <p>
          <strong>Starting at $150/month</strong> with zero down payment. That's
          less than most businesses spend on a single print ad.
        </p>
        <p><strong>What's Included:</strong></p>
        <ul class="flow" data-flow="sm">
          <li>Custom branded website design</li>
          <li>Domain name management</li>
          <li>Responsive mobile-friendly design</li>
          <li>Content management system</li>
          <li>Basic SEO optimization</li>
          <li>Hosting and maintenance</li>
          <li>Regular updates and security patches</li>
          <li>Translation services (available for an additional fee)</li>
        </ul>
      </Card>

      <Card data-flow="sm">
        <h3><a href="/services/consulting">Technical Consulting</a></h3>
        <p>
          Specialized consulting in TypeScript monorepos and PostgreSQL —
          plus broader guidance on code review, architecture planning, and
          platform evaluation. Hourly and project-based engagements that
          save you from costly mistakes.
        </p>
        <p>
          <strong>Starting at $120/hour.</strong> Weekly and project rates available.
        </p>
        <p><strong>What's Included:</strong></p>
        <ul class="flow" data-flow="sm">
          <li>TypeScript monorepo architecture (Turborepo, Nx, pnpm)</li>
          <li>PostgreSQL schema design and query optimization</li>
          <li>Code review and architecture feedback</li>
          <li>Technology and platform guidance</li>
        </ul>
      </Card>
    </Grid>
  </Section>

  <Section>
    <h2>Ready to Get Started?</h2>
    <p>
      Tell me about your project and I'll give you an honest assessment of
      what it'll take.
    </p>
    <div class="cluster">
      <a href="/contact">Get a Free Website Quote</a>
      <a href="/contact">Book a Free Consulting Call</a>
    </div>
  </Section>
</BaseLayout>
