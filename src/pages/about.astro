---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Cove from "../components/Cove.astro";
import Card from "../components/Card.astro";
import Grid from "../components/Grid.astro";
import Section from "../components/Section.astro";
import { Image } from "astro:assets";
import { SITE, BUSINESS, PERSON } from "../data/client";
import kevinPhoto from "../assets/kevin.jpg";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PERSON.firstName,
  jobTitle: PERSON.jobTitle,
  url: `${SITE.url}/about`,
  worksFor: {
    "@type": "Organization",
    name: BUSINESS.name,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.state,
    addressCountry: "US",
  },
  knowsAbout: [
    "TypeScript",
    "Monorepo Architecture",
    "PostgreSQL",
    "Web Development",
  ],
};
---

<BaseLayout
  title={`About - ${SITE.title}`}
  path="/about"
  ogTitle={`About ${PERSON.firstName} - ${SITE.title}`}
  description={`${PERSON.firstName} is a software engineer with 10+ years of experience specializing in TypeScript monorepos and PostgreSQL. He founded ${SITE.title} in ${BUSINESS.address.city}, ${BUSINESS.address.state} to bring enterprise-quality web development and technical consulting to teams that need it most.`}
  ogDescription={`${PERSON.firstName} is a software engineer with 10+ years of experience specializing in TypeScript monorepos and PostgreSQL. He founded ${SITE.title} in ${BUSINESS.address.city}, ${BUSINESS.address.state} to bring enterprise-quality development to teams that need it most.`}
  twitterDescription={`${PERSON.firstName} is a software engineer with 10+ years of experience specializing in TypeScript monorepos and PostgreSQL. Founded ${SITE.title} in ${BUSINESS.address.city}, ${BUSINESS.address.state}.`}
  jsonLd={jsonLd}
>
  <Hero slot="header" title="About Me">
    <p class="big">
      Software engineer with a decade of experience, based in {BUSINESS.address.city}, {BUSINESS.address.state}.
      I founded {SITE.title} to build better websites for small businesses and
      offer senior-level consulting to engineering teams that need it.
    </p>
  </Hero>

  <Section>
    <Grid layout="50-50">
      <div>
        <Image
          src={kevinPhoto}
          alt={`${PERSON.firstName}, founder of ${SITE.title}`}
          class="about-photo"
        />
      </div>
      <div class="flow">
        <p>
          I'm {PERSON.firstName}, a software engineer based in {BUSINESS.address.city}, {BUSINESS.address.state}. I've been
          building web applications for over a decade — dispatch systems for
          first responders, real estate platforms, marketing analytics
          tools. My deep specialties are TypeScript monorepos and
          PostgreSQL.
        </p>
        <p>
          I started {SITE.title} because I kept seeing the same gap:
          small businesses paying too much for mediocre websites, and
          engineering teams paying too much for mediocre consulting. I knew
          I could do better at both.
        </p>
        <p>
          On the web development side, I build
          <a href="/services/small-business"
            >custom sites for small businesses</a
          >
          at a price that makes sense — $150/month, no upfront costs. On the <a
            href="/services/consulting">consulting side</a
          >, I help engineering teams untangle monorepo architectures and
          fix database performance problems.
        </p>
      </div>
    </Grid>
  </Section>

  <Cove top static>
    <div class="section__inner">
      <Section>
        <h2>What I Believe</h2>
        <p>
          The web should be fast, accessible, and owned by the people who
          create content for it. You shouldn't need to be locked into a
          platform or pay exorbitant fees just to have a professional online
          presence.
        </p>
        <p>
          Good software is thoughtful software — built with real
          understanding of how people use it. I write every line of code
          myself, and I stand behind it. That's the standard I bring to
          every <a href="/services/small-business">small business website</a
          >
          and <a href="/services/consulting">consulting engagement</a>.
        </p>
      </Section>
    </div>
  </Cove>

  <Section>
    <h2>Technical Expertise</h2>
    <Grid layout="50-50">
      <Card>
        <h3>TypeScript & Monorepos</h3>
        <p>
          Large TypeScript codebases are my home turf. I've spent years
          working in and designing monorepos — the tooling, the tradeoffs,
          and the patterns that make them work for big teams. Turborepo, Nx,
          pnpm workspaces, TypeScript project references — I know where
          these tools shine and where they break down.
        </p>
        <p>
          If you're a team struggling with slow builds, tangled
          dependencies, or a repo structure that's grown past what anyone
          planned for, I can help you untangle it.
        </p>
      </Card>
      <Card>
        <h3>PostgreSQL</h3>
        <p>
          PostgreSQL is one of the most powerful databases available — and
          one of the most commonly misused. I've worked extensively with
          schema design, query optimization, indexing strategy, and
          migration planning across projects at various scales.
        </p>
        <p>
          When a database starts causing problems — slow queries, connection
          pool exhaustion, schema debt — I know how to diagnose the root
          cause and fix it without a complete rewrite.
        </p>
      </Card>
    </Grid>
  </Section>

  <Section>
    <h2>Let's Work Together</h2>
    <p>
      Need a website for your business or technical help with your codebase?
      I'd love to hear from you.
    </p>
    <p>
      <a href="/contact">Get in Touch</a>
    </p>
  </Section>
</BaseLayout>

<style>
  .about-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--border-radius);
  }
</style>
