---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Cove from "../components/Cove.astro";
import Card from "../components/Card.astro";
import Grid from "../components/Grid.astro";
import Section from "../components/Section.astro";
import { Image } from "astro:assets";
import { SITE, BUSINESS, PERSON } from "../data/client";
import { PRICING, usd } from "../data/pricing";
import kevinPhoto from "../assets/kevin.jpg";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PERSON.fullName,
  jobTitle: PERSON.jobTitle,
  url: `${SITE.url}/about`,
  worksFor: {
    "@type": "Organization",
    name: BUSINESS.name,
  },
  knowsAbout: [
    "Web Development",
    "Web Design",
    "Search Engine Optimization",
    "TypeScript",
    "PostgreSQL",
  ],
};
---

<BaseLayout
  title={`About ${PERSON.fullName} — ${SITE.title}`}
  path="/about"
  ogTitle={`About ${PERSON.firstName} — ${SITE.title}`}
  description={`${PERSON.firstName} is a software engineer with 10+ years of experience building software teams depend on. He founded ${SITE.title} to give small businesses the kind of website usually reserved for companies with an engineering department — for a flat monthly price.`}
  ogDescription={`${PERSON.firstName} is a software engineer with 10+ years of experience. He founded ${SITE.title} to build small business websites the way real software gets built.`}
  twitterDescription={`${PERSON.firstName} is a software engineer with 10+ years of experience. Founded ${SITE.title} to build better small business websites.`}
  jsonLd={jsonLd}
>
  <Hero slot="header" title={`About ${PERSON.fullName}`}>
    <p class="big">
      Software engineer with a decade of experience, working remotely with
      small businesses across the US. I founded {SITE.title} to build small business websites the way real
      software gets built — and to charge for them in a way that makes sense.
    </p>
  </Hero>

  <Section>
    <Grid layout="50-50">
      <div>
        <Image
          src={kevinPhoto}
          alt={`${PERSON.firstName}, founder of ${SITE.title}`}
          class="about-photo"
        />
      </div>
      <div class="flow">
        <p>
          I'm {PERSON.firstName}, a software engineer and {PERSON.hometown} native. I've spent
          over a decade building software that other people's businesses run
          on — dispatch systems for first responders, real estate platforms,
          marketing analytics tools. Along the way I got deep into the
          PostgreSQL database and the open-source community around it.
        </p>
        <p>
          I started {SITE.title} because I kept seeing the same gap: small
          businesses paying agency prices for a template with their logo
          swapped in, or paying nothing and getting a Wix site that never
          shows up on Google. The skills that make software reliable for a
          911 dispatcher — speed, correctness, care — are exactly what a
          plumber's or a bakery's website needs too. Almost nobody sells
          them at that price.
        </p>
        <p>
          So that's what I do: I build
          <a href="/services/small-business"
            >custom sites for small businesses</a
          >
          for {usd(PRICING.monthly)}/month with $0 down, and I keep them fast, secure and
          up to date for as long as you're a client. You talk to me, the
          person writing the code, every time.
        </p>
      </div>
    </Grid>
  </Section>

  <Cove top static>
    <div class="section__inner">
      <Section>
        <h2>What I Believe</h2>
        <p>
          The web should be fast, accessible, and respectful of the people
          who create content for it. You shouldn't need to be locked into a
          platform or pay exorbitant fees just to have a professional online
          presence.
        </p>
        <p>
          Good software is thoughtful software — built with real
          understanding of how people use it. I write every line of code
          myself, and I stand behind it. That's the standard I bring to
          every <a href="/services/small-business">small business website</a
          >, whether it's a five-page site or a fifteen-page one.
        </p>
      </Section>
    </div>
  </Cove>

  <Section ornament>
    <h2>Why That Background Matters for Your Website</h2>
    <Grid layout="50-50">
      <Card>
        <h3>Built Like Real Software</h3>
        <p>
          Most small business sites are assembled in a page builder by
          someone who has never had to keep software running under load. I
          have — for over a decade, on systems where an outage meant a 911
          call didn't get dispatched. Your site gets the same habits:
          version control, automated builds, and a boring, reliable host.
        </p>
        <p>
          The practical result is a site that scores 100 on Google
          Lighthouse, loads in under a second on a phone, and doesn't break
          when a plugin updates — because there are no plugins.
        </p>
      </Card>
      <Card>
        <h3>Deep in the Open-Source Community</h3>
        <p>
          I contribute to PostgreSQL, the open-source database that runs a
          large part of the internet, and I build and operate my own
          software on top of it. That's not a service I'm selling you — it's
          just the kind of engineer you're getting: one who maintains
          software for the long haul, not one who ships and moves on.
        </p>
        <p>
          It also means I build on open web standards, not a proprietary
          platform. Your domain and your content are always yours, and
          nothing about the site is a secret only I know.
        </p>
      </Card>
    </Grid>
  </Section>

  <Section>
    <h2>Let's Work Together</h2>
    <p>
      Need a website for your business — or a better one than you have now?
      I'd love to hear from you.
    </p>
    <p>
      <a href="/contact">Get in Touch</a>
    </p>
  </Section>
</BaseLayout>

<style>
  .about-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--border-radius);
  }
</style>
