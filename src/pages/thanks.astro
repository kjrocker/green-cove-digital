---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import { SITE, BUSINESS } from "../data/client";
---

<BaseLayout title={`Thanks — ${SITE.title}`} noindex>
  <Hero slot="header" title="Thanks — message received">
    <p>
      I'll get back to you within one business day. If it's urgent, you can also
      reach me directly at
      <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>.
    </p>
  </Hero>

  <Section>
    <h2>What Happens Next</h2>
    <p>
      You should see a confirmation email in your inbox shortly. I'll reply with
      some initial questions about your project, and from there we'll set up a
      short call to talk through scope and next steps — no obligation.
    </p>
    <p>
      <a href="/">← Back to home</a>
    </p>
  </Section>
</BaseLayout>
