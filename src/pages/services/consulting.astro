---
import Curve from "../../components/Curve.astro";
import Footer from "../../components/Footer.astro";
import Cove from "../../components/Cove.astro";
import Navigation from "../../components/Navigation.astro";
import "../../css/reset.css";
import "../../css/global.css";
import "../../css/index.css";
import { SITE, BUSINESS } from "../../data/client";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={`${SITE.url}/services/consulting`} />
    <meta
      name="description"
      content="TypeScript monorepo and PostgreSQL consulting from an experienced software engineer. Expert guidance on monorepo architecture (Turborepo, Nx, pnpm workspaces), PostgreSQL schema design, query optimization, code review, and platform evaluation. Starting at $120/hour."
    />
    <meta
      property="og:title"
      content={`TypeScript Monorepo & PostgreSQL Consulting | ${SITE.title}`}
    />
    <meta
      property="og:description"
      content="TypeScript monorepo and PostgreSQL consulting. Expert guidance on Turborepo, Nx, pnpm workspaces, PostgreSQL schema design and query optimization. Starting at $120/hour. First consultation is free."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content={`TypeScript Monorepo & PostgreSQL Consulting | ${SITE.title}`}
    />
    <meta
      name="twitter:description"
      content="TypeScript monorepo and PostgreSQL consulting. Expert guidance on Turborepo, Nx, pnpm workspaces, PostgreSQL schema design and query optimization. Starting at $120/hour."
    />
    <title>
      TypeScript Monorepo & PostgreSQL Consulting - {SITE.title}
    </title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "TypeScript Monorepo & PostgreSQL Consulting",
        provider: {
          "@type": "LocalBusiness",
          name: BUSINESS.name,
          address: {
            "@type": "PostalAddress",
            addressLocality: BUSINESS.address.city,
            addressRegion: BUSINESS.address.state,
            addressCountry: "US",
          },
        },
        description:
          "TypeScript monorepo and PostgreSQL consulting. Expert guidance on Turborepo, Nx, pnpm workspaces, PostgreSQL schema design and query optimization.",
        areaServed: {
          "@type": "Country",
          name: "US",
        },
        offers: {
          "@type": "Offer",
          price: "120",
          priceCurrency: "USD",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: "120",
            priceCurrency: "USD",
            unitText: "hour",
          },
        },
      })}
    />
  </head>
  <body>
    <Cove>
      <header class="flow">
        <p class="wrapper mt-m-l">
          <a href="/" class="big-brand">{SITE.title}</a>
        </p>
        <nav style="padding-top:1px;padding-bottom:1px;">
          <Navigation />
        </nav>
      </header>
      <div class="section__inner">
        <div class="wrapper flow region">
          <h1>Technical Consulting</h1>
          <p class="big">
            I specialize in TypeScript monorepos and PostgreSQL — two
            technologies that large teams depend on and that are genuinely hard
            to get right. Hourly and project-based engagements for engineering
            teams in {BUSINESS.address.city}, {BUSINESS.address.state} and remote.
          </p>
        </div>
      </div>
    </Cove>

    <main>
      <article class="flow region wrapper">
        <h2>Pricing</h2>
        <div class="grid" data-layout="50-50">
          <div class="flow">
            <h3>Starting at $120/Hour</h3>
            <p>
              <strong>Hourly consulting</strong> for one-off questions, code reviews,
              or a second opinion on a technical decision.
            </p>
            <p>
              <strong>Weekly retainers and project-based pricing</strong> for ongoing
              engagements — better value and predictable costs.
            </p>
            <p>
              First consultation is free.
              <a href="/contact">Tell me what you're working on</a> and I'll let you
              know how I can help.
            </p>
          </div>
          <div class="card flow">
            <h3>Concrete Deliverables</h3>
            <ul class="flow" data-flow="sm">
              <li>Written architecture proposals with diagrams</li>
              <li>Annotated code reviews with prioritized fixes</li>
              <li>Migration plans with timelines and risk assessment</li>
              <li>Vendor evaluations with side-by-side comparisons</li>
              <li>Follow-up support as your project evolves</li>
            </ul>
          </div>
        </div>
      </article>

      <article class="flow region wrapper">
        <h2>Specialties</h2>
        <div class="grid" data-layout="50-50">
          <div class="card flow">
            <h3>TypeScript Monorepos</h3>
            <p>
              Monorepos are a powerful pattern for large teams, but they're
              notoriously painful to set up and maintain. Slow builds, tangled
              dependencies, inconsistent tooling — I've solved these problems
              before and can help you avoid them from the start.
            </p>
            <p>
              I have deep experience with the entire monorepo ecosystem:
              Turborepo, Nx, pnpm workspaces, Yarn workspaces, and the
              TypeScript project reference configurations that tie it all
              together. Whether you're migrating an existing multi-repo setup or
              architecting a new one, I'll help you build a codebase your team
              can work in productively.
            </p>
          </div>
          <div class="card flow">
            <h3>PostgreSQL</h3>
            <p>
              PostgreSQL is used everywhere — and it's easy to use it wrong.
              Slow queries, poorly designed schemas, missing indexes, N+1
              problems — these issues compound over time and become expensive to
              fix once data grows.
            </p>
            <p>
              I can help with schema design and normalization, query
              optimization, index strategy, connection pooling, and migration
              planning. Whether you're starting fresh or inheriting a legacy
              database, I'll help you get PostgreSQL working for you instead of
              against you.
            </p>
          </div>
        </div>
      </article>

      <div class="section spot-color-primary">
        <Curve />
        <div class="section__inner">
          <article class="flow region wrapper">
            <h2>How It Works</h2>
            <p>
              Start with a free consultation. Tell me what you're working on — a
              problem you're stuck on, a decision you're weighing, or a system
              you need reviewed. I'll ask questions, give you my honest read on
              the situation, and let you know whether and how I can help.
            </p>
            <p>
              From there, we scope the engagement together. Some engagements are
              a single session to answer a specific question. Others are ongoing
              retainers where I'm available on a weekly basis. I'll recommend
              the structure that fits your situation.
            </p>
            <p>
              No retainer required to get started. No sales pitch on the first
              call.
            </p>
          </article>
        </div>
        <Curve />
      </div>

      <article class="flow region wrapper">
        <h2>How I Can Help</h2>
        <ul class="grid" data-layout="50-50" role="list">
          <li class="card flow">
            <h3>Code Review & Audit</h3>
            <p>
              A second pair of eyes on your codebase. I'll produce an annotated
              report covering security, performance, and maintainability — with
              prioritized fixes, not just a list of problems.
            </p>
          </li>
          <li class="card flow">
            <h3>Platform Evaluation</h3>
            <p>
              AWS vs. Vercel vs. Netlify? React vs. Vue? I'll give you a
              side-by-side comparison with cost estimates, trade-offs, and a
              recommendation based on your team's skills and your growth plans.
            </p>
          </li>
          <li class="card flow">
            <h3>Monorepo Architecture</h3>
            <p>
              Design a TypeScript monorepo that scales with your team — fast
              builds, clear package boundaries, and shared tooling. I'll help
              you choose between Turborepo, Nx, and pnpm workspaces, configure
              TypeScript project references, and establish code-sharing patterns
              that won't become a dependency mess.
            </p>
          </li>
          <li class="card flow">
            <h3>Technical Due Diligence</h3>
            <p>
              Acquiring a company or evaluating a technology partner? I'll
              assess code quality, infrastructure, and technical debt — and give
              you a written report so you know what you're buying.
            </p>
          </li>
          <li class="card flow">
            <h3>PostgreSQL Performance</h3>
            <p>
              Slow queries, runaway costs, or a schema that's started working
              against you? I'll identify the actual bottlenecks — missing
              indexes, inefficient queries, N+1 patterns — and fix them.
            </p>
            <p>
              I'll profile your queries with <code>EXPLAIN ANALYZE</code>,
              optimize index strategy, tune connection pooling, and make
              targeted changes that deliver measurable improvements without
              rewriting your entire data layer.
            </p>
          </li>
          <li class="card flow">
            <h3>Team Training & Mentorship</h3>
            <p>
              Hands-on training tailored to your stack — TypeScript best
              practices, testing strategy, security fundamentals, or monorepo
              workflows. Practical sessions, not slide decks.
            </p>
          </li>
        </ul>
      </article>

      <div class="section spot-color-primary">
        <Curve />
        <div class="section__inner">
          <article class="flow region wrapper">
            <h2>Who I Work With</h2>
            <p>
              Engineering leads and CTOs at startups and mid-size companies
              (typically teams of 5–50 engineers) who need senior-level
              expertise without a full-time hire.
            </p>
            <p>
              Non-technical founders making their first infrastructure
              decisions. Small development teams that need a second opinion on
              architecture. Companies evaluating a technical acquisition.
            </p>
          </article>
        </div>
        <Curve />
      </div>

      <article class="flow region wrapper">
        <h2>Let's Talk</h2>
        <p>
          Tell me what you're working on. First consultation is free — no
          obligation, no sales pitch.
        </p>
        <p>
          <a href="/contact">Book Your Free Consultation</a>
        </p>
      </article>
    </main>

    <Footer />
  </body>
</html>
