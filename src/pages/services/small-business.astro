---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Card from "../../components/Card.astro";
import Grid from "../../components/Grid.astro";
import SpotBand from "../../components/SpotBand.astro";
import Section from "../../components/Section.astro";
import { SITE, BUSINESS, PERSON } from "../../data/client";

const faqs: { q: string; a: string }[] = [
  {
    q: "What does $150 a month actually cover?",
    a: "Design and build of your site (up to five pages to start), hosting, SSL, your domain, security and software updates, and ongoing content changes — new hours, a new service, a photo swap. Email me the change and it's done, usually within a couple of business days. There is no separate maintenance plan and no hosting bill.",
  },
  {
    q: "Is there a contract or a minimum term?",
    a: "Twelve months, starting as soon as the work does with a one-month no-questions-asked refund. A custom site is weeks of work, at $150 a month it takes a year for that work to be worth doing. After the twelve months you're month to month and can cancel with 30 days' notice.",
  },
  {
    q: "What if I have to cancel during the first year?",
    a: "When we're working on the site, a simple “this isn't working” means we shake hands and stop. Once the site is launched, the cancellation fee is the same as the minimum term: $1,800, minus whatever you've already paid. That's it: no penalty on top, and nothing at all once the year is up. Either way, your domain and your content are yours and stay yours.",
  },
  {
    q: "Can I just buy the site outright instead?",
    a: "Yes. You pay for the build once and it's yours, the design and the code included, with no minimum term because everything is paid for. Afterwards you either leave the site with me on a nominal monthly hosting fee, or take the files and go.",
  },
  {
    q: "Do I keep my website if I cancel?",
    a: "The site itself, no. What you always keep: your domain; every word of content you wrote; and every logo, photo and file you sent me. I'll make sure you have all of it and point the domain wherever you tell me. Nothing that belongs to your business is ever held hostage.",
  },
  {
    q: "What if I need more than five pages?",
    a: "Extra pages are a one-time $100 each — not a monthly increase. If you need something much larger, we can figure it out.",
  },
  {
    q: "What happens after the first year?",
    a: "The price doesn't move and the service doesn't change — there's no “introductory rate” that quietly steps up in month thirteen. Every couple of years I'll refresh the design so it doesn't go stale — that's included too.",
  },
  {
    q: "How long does it take?",
    a: "Typically two to four weeks from our first call to a live site, depending on how quickly we can get your content together. A simple site with content ready can be faster.",
  },
  {
    q: "What do you need from me?",
    a: "A short call about your business, your logo and any brand colours you have, some photos if you have them (I can source stock if not), and about an hour of your time reviewing drafts. Professional, search-optimized content is written for you from our conversation — you don't need to sit down and write your website.",
  },
  {
    q: "What if I don't like the design?",
    a: "Then we don't launch it. You can watch the build on a private preview link, so there are no surprises. If we can't land on a design you're happy with, we shake hands and walk away.",
  },
  {
    q: "Can I update the site myself?",
    a: "Yes. For simple things such as hours or blog posts I'll include a content editor. Most clients find it faster to just email me the change, and that's included, so it's your call.",
  },
  {
    q: "Will it show up on Google?",
    a: "Every site ships with the technical SEO groundwork done properly: fast load times, mobile-first layout, clean structure, local business schema, and copy written around what your customers actually search for. That's a real advantage over most small business sites. But nobody can promise a specific ranking — how fast you climb depends on your competition, your reviews, and time.",
  },
  {
    q: "Where is the site hosted, and how secure is it?",
    a: "On modern, professionally run hosting infrastructure with a global network in front of it — not a shared server or a computer in my office. Sites without a content editor are served as plain pre-built pages, so there is almost nothing to break into; sites with one are kept patched as part of the subscription. Either way, SSL and backups are handled and you never see a hosting bill.",
  },
  {
    q: "Do you build online stores?",
    a: "Small ones — a handful of products or services with checkout, yes. A large catalogue with inventory, shipping rules and thousands of SKUs is a different kind of project with very different requirements.",
  },
  {
    q: "Do you work with businesses outside Charlotte?",
    a: "Yes. I'm based in Charlotte, NC, but everything about the process works just as well over a call. I have no preference and no travel surcharge.",
  },
  {
    q: "What if something happens to you?",
    a: "Fair question to ask a one-person business. Your site runs on professionally managed hosting, not on a computer in my house, so it doesn't go offline because I'm unreachable. Your domain is in your name and your content is yours, so if I ever wound the business down you would get a full export and any web designer could rebuild from it. You are never locked out of your own site.",
  },
  {
    q: "Do you offer other languages?",
    a: "Yes. I can deliver your site in Spanish or other languages using certified professional translators — not machine translation — for an additional fee that depends on the amount of content.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Small Business Website Design & Development",
      serviceType: "Web Design",
      provider: {
        "@type": "LocalBusiness",
        name: BUSINESS.name,
        url: SITE.url,
        address: {
          "@type": "PostalAddress",
          addressLocality: BUSINESS.address.city,
          addressRegion: BUSINESS.address.state,
          addressCountry: "US",
        },
      },
      description:
        "Custom small business websites for $150/month with zero down payment. Includes design, hosting, domain, maintenance, content updates and local SEO. Twelve-month minimum term from launch, then month-to-month with 30 days' notice.",
      areaServed: [
        { "@type": "City", name: BUSINESS.address.city },
        { "@type": "Country", name: "US" },
      ],
      offers: {
        "@type": "Offer",
        price: "150",
        priceCurrency: "USD",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "150",
          priceCurrency: "USD",
          unitText: "month",
        },
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
  ],
};
---

<BaseLayout
  title={`Small Business Website Pricing — $150/Month, $0 Down | ${SITE.title}`}
  path="/services/small-business"
  ogTitle={`Small Business Websites: $150/Month, $0 Down | ${SITE.title}`}
  description={`Custom small business websites in ${BUSINESS.address.city}, ${BUSINESS.address.state} and beyond for $150/month with zero down. Design, hosting, domain, updates and local SEO included. Twelve-month minimum, then month to month. Your domain and content stay yours.`}
  ogDescription="Custom small business websites for $150/month with zero down. Design, hosting, updates and local SEO included. Twelve-month minimum, then month to month — your domain and content are always yours."
  jsonLd={jsonLd}
>
  <Hero slot="header" title="Small Business Websites">
    <p class="big">
      A custom website designed for your business: built by hand, optimized for
      local search, and fast enough to score 100 on Google Lighthouse. Serving
      small businesses in {BUSINESS.address.city}, {BUSINESS.address.state} and everywhere
      else.
    </p>
    <div class="cluster">
      <a href="/contact">Get a Free Quote</a>
      <a href="#faq">Read the FAQ</a>
    </div>
  </Hero>

  <Section>
    <h2>Pricing That Makes Sense</h2>
    <Grid layout="50-50">
      <div class="flow">
        <h3>$150/Month. $0 Down.</h3>
        <p>
          One predictable monthly payment that covers design, hosting,
          maintenance, and updates. Squarespace charges $33/month and makes you
          build it. I build something custom for $150 and keep looking after it.
        </p>
        <p>
          <strong>$0 down, twelve-month minimum.</strong> After that you're month
          to month, just cancel with 30 days' notice.
        </p>
        <p>
          <strong>Typical turnaround:</strong> 2-4 weeks from our first conversation
          to a live site, depending on content and scope.
        </p>
        <p>
          <strong>Nothing to lose:</strong> Full refund any time before the site launch.
          Up to that point, either of us can say it isn't working.
        </p>
      </div>
      <Card>
        <h3>What's Included</h3>
        <ul class="flow" data-flow="sm">
          <li>Custom design — no templates</li>
          <li>Up to five pages to start</li>
          <li>Professional, search-optimized content</li>
          <li>Domain name registration and management</li>
          <li>Mobile-first, responsive design</li>
          <li>Optional content editor for blogs, annoucements, etc.</li>
          <li>Local SEO groundwork: schema, speed, structure, keywords</li>
          <li>Hosting, SSL, and backups</li>
          <li>Ongoing content changes — just email me</li>
          <li>Security and software updates</li>
          <li>Translation by certified professionals (additional fee)</li>
        </ul>
      </Card>
    </Grid>
  </Section>

  <SpotBand>
    <h2>Why a Monthly Fee?</h2>
    <p>
      Because a website is always changing. The menu changes, the summer hours
      start, you add a service, a staff photo is three years old. Each fix is a
      five-minute job, but each one is a small enough job that nobody wants to
      file a ticket or pay a minimum fee. So it doesn't get done, and a year
      later your site is quietly wrong about your own business.
    </p>
    <p>
      A subscription solves that problem, the small fixes get solved and your
      site stays up to date. It lines up my incentives with yours: I only get
      paid next month if the site is still fast, secure and online this month.
      And it turns a $5,000 decision into a $150 one you can make this week.
    </p>
    <p>
      It's also the trade behind the twelve-month minimum. Building the site is
      weeks of work, paid for by the first year of the subscription. I'd rather
      ask you for twelve months than for a few thousand dollars on day one.
    </p>
  </SpotBand>

  <Section>
    <h2>How It Works</h2>
    <Grid as="ol" layout="thirds" role="list">
      <Card as="li">
        <h3>1. A short call</h3>
        <p>
          You tell me about your business, your customers, and what you want the
          site to do. I'll tell you what I'd build and how long it'll take. If
          it's a fit, I send a one-page written summary — no contract to sign,
          nothing to pay yet.
        </p>
      </Card>
      <Card as="li">
        <h3>2. Design, then build — in the open</h3>
        <p>
          Professional, search-optimized content is written from our
          conversation, and the design is built around your brand. I'll work
          with you on the design, and you can preview the site as it comes
          together. You are never waiting weeks to find out what you got.
        </p>
      </Card>
      <Card as="li">
        <h3>3. Launch, then keep going</h3>
        <p>
          The site goes live on your domain. From then on you email me changes
          and they get made. Hosting, backups and updates happen without you
          thinking about them.
        </p>
      </Card>
    </Grid>
    <p>
      <a href="/contact">Book the call</a>
    </p>
  </Section>

  <SpotBand>
    <h2>Built for Performance</h2>
    <p>
      Every extra second of load time costs you visitors and sales. My sites
      load in under a second — I optimize images, strip out unnecessary code,
      and use modern hosting infrastructure to keep things fast.
    </p>
    <p>
      Fast sites rank higher on Google and convert better. This site scores 100
      on Google Lighthouse, and yours will too. Curious how your current site
      does? Run it through Google's free
      <a href="https://pagespeed.web.dev/">PageSpeed Insights</a> — then run this
      one.
    </p>
  </SpotBand>

  <Section ornament>
    <h2>Perfect For</h2>
    <Grid as="ul" layout="50-50" role="list">
      <Card as="li">
        <h3>Local Services</h3>
        <p>
          Plumbers, electricians, landscapers, contractors. A mobile-friendly
          site with clear contact info, service areas, and the SEO work needed
          to show up when someone searches "plumber near me."
        </p>
      </Card>
      <Card as="li">
        <h3>Retail & Small Shops</h3>
        <p>
          Boutiques and specialty stores. Product showcases, simple payment
          processing if you need it, and a site that works on the phones and
          tablets where most browsing happens.
        </p>
      </Card>
      <Card as="li">
        <h3>Professional Services</h3>
        <p>
          Consultants, lawyers, accountants, therapists. A site that establishes
          credibility, explains your services clearly, and makes it easy for
          clients to book a consultation.
        </p>
      </Card>
      <Card as="li">
        <h3>Restaurants & Hospitality</h3>
        <p>
          Easy-to-update menus, hours, location info, and reservation
          integration if needed. Update specials yourself — or email me and I'll
          do it.
        </p>
      </Card>
    </Grid>
  </Section>

  <SpotBand>
    <h2>No Vendor Lock-In</h2>
    <p>
      Your domain, your content, your customer data — it all stays yours,
      always. Unlike Squarespace or Wix, your business's identity isn't tied up
      in a large corporation that can raise prices, restrict features, or change
      its policies overnight.
    </p>
    <p>
      The only thing I own is the design and the code, hosted and managed for
      you as long as you're a client. If you'd rather own the code too, I'm
      happy to work with you, the details are right below.
    </p>
  </SpotBand>

  <Section id="own-it">
    <h2>The Other Way to Buy It</h2>
    <Grid layout="50-50">
      <div class="flow">
        <h3>Pay Once. Own It Outright.</h3>
        <p>
          Most small businesses would rather not write a four-figure check for
          a website. But you can, and in that case the site is yours
          outright, design and code included, with no minimum term.
        </p>
        <p>
          <strong>Built, then hosted.</strong> The site stays on the same managed
          infrastructure — SSL, backups, security updates — for a nominal monthly
          fee. Changes are quoted as they come up.
        </p>
        <p>
          <strong>Built, then handed over.</strong> You take the files and we're done.
          No monthly bill, nothing to cancel.
        </p>
        <p>
          <strong>The price:</strong> quoted per project. Which model costs less over
          a few years depends on that number and on how much your site actually changes.
        </p>
      </div>
      <Card>
        <h3>What Changes</h3>
        <ul class="flow" data-flow="sm">
          <li>
            You own the design and the code
          </li>
          <li>No minimum term; there's nothing left to pay off</li>
          <li>One larger payment up front instead of $150 a month</li>
          <li>Hosting is either a nominal monthly fee or entirely yours</li>
          <li>
            Changes aren't included — quoted as they come up, or yours to make
          </li>
          <li>No design refresh every couple of years</li>
        </ul>
      </Card>
    </Grid>
    <p>
      <a href="/contact">Ask about a one-time build</a>
    </p>
  </Section>

  <Section id="faq">
    <h2>Frequently Asked Questions</h2>
    <div class="accordion">
      {
        faqs.map(({ q, a }) => (
          <details open>
            <summary>
              <h3>{q}</h3>
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
    {
      /* The only script on the site. Every panel is rendered `open`, so with
         JavaScript off the FAQ is a plain list of questions and answers —
         and `<details>` still toggles natively. This collapses them into an
         accordion. `is:inline` keeps it here in the markup rather than
         bundling it into a deferred module, so it runs while the parser is
         still inside this section and the FAQ never paints open. */
    }
    <script is:inline>
      for (const item of document.querySelectorAll("#faq details"))
        item.open = false;
    </script>
    <p>
      Something I didn't cover? <a href="/contact">Ask {PERSON.firstName}</a>
      — I reply within one business day.
    </p>
  </Section>

  <Section>
    <h2>Ready to Get Started?</h2>
    <p>
      Tell me about your business and I'll let you know what a site would look
      like and how long it'll take. No commitment.
    </p>
    <p>
      <a href="/contact">Start Your Website — $0 Down</a>
    </p>
  </Section>
</BaseLayout>

<style>
  .accordion {
    --rule: color-mix(in srgb, currentColor 20%, transparent);
    border-block-end: 1px solid var(--rule);
    /* Lets ::details-content animate between 0 and auto where supported. */
    interpolate-size: allow-keywords;
  }

  .accordion > details {
    border-block-start: 1px solid var(--rule);
  }

  .accordion summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    gap: var(--space-s);
    justify-content: space-between;
    /* The default marker, in Firefox and Safari respectively. */
    list-style: none;
    padding-block: var(--space-s);

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      color: var(--color-primary);
    }
  }

  /* A step down from a standalone h3: fifteen rows of --size-step-3 read as
     fifteen headings rather than as one list. The global 20ch cap on headings
     is a measure for a block of prose — in a row with a chevron pinned to the
     far right it just wraps short questions in two for no reason. */
  .accordion h3 {
    font-size: var(--size-step-2);
    max-width: 40ch;
  }

  /* Chevron, drawn from two borders so it needs no asset. */
  .accordion summary::after {
    block-size: 0.5em;
    border-block-end: 2px solid;
    border-inline-end: 2px solid;
    content: "";
    flex: none;
    inline-size: 0.5em;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform var(--transition-base);
  }

  .accordion details[open] summary::after {
    transform: translateY(0.1em) rotate(-135deg);
  }

  .accordion p {
    padding-block-end: var(--space-m);
  }

  /* Height animation. Inert in browsers without ::details-content — they just
     snap open, which is the pre-2024 <details> behaviour. */
  .accordion details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size var(--transition-base),
      content-visibility var(--transition-base);
    transition-behavior: allow-discrete;
  }

  .accordion details[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion summary::after,
    .accordion details::details-content {
      transition: none;
    }
  }
</style>
