---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Card from "../../components/Card.astro";
import Grid from "../../components/Grid.astro";
import SpotBand from "../../components/SpotBand.astro";
import Section from "../../components/Section.astro";
import { SITE, BUSINESS, PERSON } from "../../data/client";
import { PRICING, usd } from "../../data/pricing";

const faqs: { q: string; a: string }[] = [
  {
    q: `What does ${usd(PRICING.monthly)} a month actually cover?`,
    a: "Design and build of your site (up to five pages to start), hosting, SSL, your domain, security and software updates, and ongoing content changes — new hours, a new service, a photo swap. Email me the change and it's done, usually within a couple of business days. There is no separate maintenance plan and no hosting bill.",
  },
  {
    q: "When does the first payment happen?",
    a: `When the work starts. The first ${usd(PRICING.monthly)} is what puts you on the calendar — there's no lump sum up front and no deposit on top of it. From there it's the same ${usd(PRICING.monthly)} every month, while the site is being built and after it's live.`,
  },
  {
    q: "Is there a contract or a minimum term?",
    a: `Yes: twelve monthly payments, starting with the first one. A custom site is weeks of work, and at ${usd(PRICING.monthly)} a month it takes about a year for that work to be worth doing — that's the trade for $0 down. After the twelve months you're month to month and can cancel with 30 days' notice.`,
  },
  {
    q: "What if I have to cancel during the first year?",
    a: `The first year is a commitment, so the remaining monthly payments are still owed — there's no penalty on top of that, and nothing at all once the year is up. Either way, your domain and your content are yours and stay yours.`,
  },
  {
    q: "Do I keep my website if I cancel?",
    a: "The site itself, no. What you always keep: your domain; every word of content you wrote; and every logo, photo and file you sent me. I'll make sure you have all of it and point the domain wherever you tell me. Nothing that belongs to your business is ever held hostage.",
  },
  {
    q: "What if I need more than five pages?",
    a: `Extra pages are a one-time ${usd(PRICING.extraPage)} each — not a monthly increase. If you need something much larger, we can work it out.`,
  },
  {
    q: "What happens after the first year?",
    a: "The price doesn't move and the service doesn't change — there's no “introductory rate” that quietly steps up in month thirteen. Every four years I'll refresh the design so it doesn't go stale — that's included too.",
  },
  {
    q: "How long does it take?",
    a: "Typically two to four weeks from our first call to a live site, depending on how quickly we can get your content together. A simple site with content ready can be faster.",
  },
  {
    q: "What do you need from me?",
    a: "A short call about your business, your logo and any brand colors you have, some photos if you have them (I can source stock if not), and about an hour of your time reviewing drafts. Professional, search-optimized content is written for you from our conversation — you don't need to sit down and write your website.",
  },
  {
    q: "What if I don't like the design?",
    a: "Then we don't launch it. You can watch the build on a private preview link, so there are no surprises, and we keep iterating until it's right — I'd rather spend another week on the design than put something live that you don't like.",
  },
  {
    q: "Can I update the site myself?",
    a: "Yes. For simple things such as hours or blog posts I'll include a content editor. Most clients find it faster to just email me the change, and that's included, so it's your call.",
  },
  {
    q: "Will it show up on Google?",
    a: "Every site ships with the technical SEO groundwork done properly: fast load times, mobile-first layout, clean structure, local business schema, and copy written around what your customers actually search for. That's a real advantage over most small business sites. But nobody can promise a specific ranking — how fast you climb depends on your competition, your reviews, and time.",
  },
  {
    q: "Where is the site hosted, and how secure is it?",
    a: "On modern, professionally run hosting infrastructure with a global network in front of it — not a shared server or a computer in my office. Sites without a content editor are served as plain pre-built pages, so there is almost nothing to break into; sites with one are kept patched as part of the subscription. Either way, SSL and backups are handled and you never see a hosting bill.",
  },
  {
    q: "Do you build online stores?",
    a: "Small ones — a handful of products or services with checkout, yes. A large catalog with inventory, shipping rules and thousands of SKUs is a different kind of project with very different requirements.",
  },
  {
    q: "Do you work with businesses in my area?",
    a: "Yes — anywhere in the US. Everything happens over calls, email and a private preview link, so it works the same wherever you are. Most of my clients I never meet in person, and it has never mattered.",
  },
  {
    q: "What if something happens to you?",
    a: "Fair question to ask a one-person business. Your site runs on professionally managed hosting, not on a computer in my house, so it doesn't go offline because I'm unreachable. Your domain is in your name and your content is yours, so if I ever wound the business down you would get a full export and any web designer could rebuild from it. You are never locked out of your own site.",
  },
  {
    q: "Do you offer other languages?",
    a: "Often, yes. For Spanish and other languages I bring in a professional translator — not machine translation — for an additional fee that depends on the amount of content. It depends on the language, so ask and I'll tell you whether I can do it.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Small Business Website Design & Development",
      serviceType: "Web Design",
      provider: {
        "@type": "Organization",
        name: BUSINESS.name,
        legalName: BUSINESS.legalName,
        url: SITE.url,
      },
      description: `Custom small business websites for ${usd(PRICING.monthly)}/month with zero down payment. Includes design, hosting, domain, maintenance, content updates and local SEO. Twelve-month minimum, then month-to-month with 30 days' notice.`,
      areaServed: { "@type": "Country", name: BUSINESS.areaServed },
      offers: {
        "@type": "Offer",
        price: String(PRICING.monthly),
        priceCurrency: "USD",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: String(PRICING.monthly),
          priceCurrency: "USD",
          unitText: "month",
        },
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
  ],
};
---

<BaseLayout
  title={`Small Business Website Pricing — ${usd(PRICING.monthly)}/mo, $0 Down | ${SITE.title}`}
  path="/services/small-business"
  ogTitle={`Small Business Websites: ${usd(PRICING.monthly)}/Month, $0 Down | ${SITE.title}`}
  description={`${usd(PRICING.monthly)}/month, $0 down: custom small business websites, built remotely for businesses anywhere in the US. Design, hosting, domain, updates and local SEO included. Twelve-month minimum, then month to month.`}
  ogDescription={`Custom small business websites for ${usd(PRICING.monthly)}/month with zero down. Design, hosting, updates and local SEO included. Twelve-month minimum, then month to month — your domain and content are always yours.`}
  jsonLd={jsonLd}
>
  <Hero slot="header" title="Small Business Websites">
    <p class="big">
      A custom website for your business — built by hand, optimized for local
      search, and fast. One flat monthly price, $0 down. Here's exactly what
      it costs and what's included.
    </p>
    <div class="cluster">
      <a href="/contact">Book a Call</a>
      <a href="#faq">Read the FAQ</a>
    </div>
  </Hero>

  <Section>
    <h2>What It Costs</h2>
    <Grid layout="50-50">
      <div class="flow">
        <h3>{usd(PRICING.monthly)}/Month. $0 Down.</h3>
        <p>
          One predictable monthly payment that covers design, hosting,
          maintenance, and updates. Squarespace charges $20–40 a month and makes
          you build it. I build something custom for {usd(PRICING.monthly)} and keep looking after it.
        </p>
        <p>
          <strong>What $0 down means:</strong> no lump sum up front. The first
          month's {usd(PRICING.monthly)} is what starts the work, and there's nothing else to pay.
        </p>
        <p>
          <strong>Twelve-month minimum.</strong> After the first year you're
          month to month — cancel with 30 days' notice. The
          <a href="#faq">FAQ</a> has the details.
        </p>
        <p>
          <strong>Typical turnaround:</strong> 2–4 weeks from our first conversation
          to a live site, depending on content and scope.
        </p>
      </div>
      <Card>
        <h3>What's Included</h3>
        <ul class="flow" data-flow="sm">
          <li>Custom design — no templates</li>
          <li>Up to five pages to start</li>
          <li>Professional, search-optimized content</li>
          <li>Domain name registration and management</li>
          <li>Mobile-first, responsive design</li>
          <li>Optional content editor for blogs, announcements, etc.</li>
          <li>Local SEO groundwork: schema, speed, structure, keywords</li>
          <li>Hosting, SSL, and backups</li>
          <li>Ongoing content changes — just email me</li>
          <li>Security and software updates</li>
        </ul>
      </Card>
    </Grid>
  </Section>

  <SpotBand>
    <h2>Why a Monthly Fee?</h2>
    <p>
      Because a website is never done. The menu changes, the summer hours start,
      you add a service, a staff photo is three years old. Each fix is a
      five-minute job, but each one is small enough that nobody wants to file a
      ticket or pay a minimum fee for it. So it doesn't get done, and a year
      later your site is quietly wrong about your own business.
    </p>
    <p>
      A subscription puts those small fixes inside the price, so they actually
      happen. It also lines up my incentives with yours: once the first year is
      up, you only keep paying if the site is still fast, secure and online. And it turns a
      $5,000 decision into a {usd(PRICING.monthly)} one you can make this week.
    </p>
    <p>
      It's also the trade behind the twelve-month minimum. Building the site is
      weeks of work, paid for by the first year of the subscription. I'd rather
      ask you for twelve months than for a few thousand dollars on day one.
    </p>
  </SpotBand>

  <Section>
    <h2>How It Works</h2>
    <Grid as="ol" layout="thirds" role="list">
      <Card as="li">
        <h3>1. A short call</h3>
        <p>
          You tell me about your business, your customers, and what you want the
          site to do. I'll tell you what I'd build and how long it'll take. If
          it's a fit, I send a one-page written summary of scope, timeline,
          price and terms. Nothing is signed or paid on the call.
        </p>
      </Card>
      <Card as="li">
        <h3>2. Design, then build — in the open</h3>
        <p>
          Professional, search-optimized content is written from our
          conversation, and the design is built around your brand. I'll work
          with you on the design, and you can watch the site come together on a
          private preview link. You're never waiting weeks for a reveal.
        </p>
      </Card>
      <Card as="li">
        <h3>3. Launch, then keep going</h3>
        <p>
          The site goes live on your domain. From then on you email me changes
          and they get made. Hosting, backups and updates happen without you
          thinking about them.
        </p>
      </Card>
    </Grid>
    <p>
      <a href="/contact">Book a Call</a>
    </p>
  </Section>

  <SpotBand>
    <h2>Built for Performance</h2>
    <p>
      Every extra second of load time costs you visitors and sales. My sites
      load in under a second — I optimize images, strip out unnecessary code,
      and use modern hosting infrastructure to keep things fast.
    </p>
    <p>
      Fast sites rank higher on Google and convert better. This site scores 100
      on Google Lighthouse, and every site I build is held to the same bar. Curious how your current site
      does? Run it through Google's free
      <a href="https://pagespeed.web.dev/">PageSpeed Insights</a> — then run this
      one.
    </p>
  </SpotBand>

  <Section ornament>
    <h2>Perfect For</h2>
    <Grid as="ul" layout="50-50" role="list">
      <Card as="li">
        <h3>Local Services</h3>
        <p>
          Plumbers, electricians, landscapers, contractors. A mobile-friendly
          site with clear contact info, service areas, and the SEO work needed
          to show up when someone searches "plumber near me."
        </p>
      </Card>
      <Card as="li">
        <h3>Retail & Small Shops</h3>
        <p>
          Boutiques and specialty stores. Product showcases, simple
          checkout for a handful of products if you need it, and a site that works on the phones and
          tablets where most browsing happens.
        </p>
      </Card>
      <Card as="li">
        <h3>Professional Services</h3>
        <p>
          Consultants, lawyers, accountants, therapists. A site that establishes
          credibility, explains your services clearly, and makes it easy for
          clients to get in touch — online booking can be added if you use it.
        </p>
      </Card>
      <Card as="li">
        <h3>Restaurants & Hospitality</h3>
        <p>
          Easy-to-update menus, hours, location info, and a link to your
          reservation system if you use one. Update specials yourself — or email me and I'll
          do it.
        </p>
      </Card>
    </Grid>
  </Section>

  <SpotBand>
    <h2>What You Keep</h2>
    <p>
      Your domain, your content, your customer data — it all stays yours,
      always. Unlike Squarespace or Wix, your business's identity isn't tied up
      in a large corporation that can raise prices, restrict features, or change
      its policies overnight.
    </p>
    <p>
      The only thing I own is the design and the code, hosted and looked after
      for as long as you're a client. If you ever leave, you take everything
      that's yours with you.
    </p>
  </SpotBand>

  <Section id="faq">
    <h2>Frequently Asked Questions</h2>
    <div class="accordion">
      {
        faqs.map(({ q, a }) => (
          <details open>
            <summary>
              <h3>{q}</h3>
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
    {
      /* The only script on the site. Every panel is rendered `open`, so with
         JavaScript off the FAQ is a plain list of questions and answers —
         and `<details>` still toggles natively. This collapses them into an
         accordion. `is:inline` keeps it here in the markup rather than
         bundling it into a deferred module, so it runs while the parser is
         still inside this section and the FAQ never paints open. */
    }
    <script is:inline>
      for (const item of document.querySelectorAll("#faq details"))
        item.open = false;
    </script>
    <p>
      Something I didn't cover? <a href="/contact">Ask {PERSON.firstName}</a>
      — I reply within one business day.
    </p>
  </Section>

  <Section>
    <h2>Ready to Get Started?</h2>
    <p>
      Tell me about your business and I'll let you know what a site would look
      like and how long it'll take. Nothing to sign and nothing to pay for the
      call.
    </p>
    <p>
      <a href="/contact">Book a Call — $0 Down</a>
    </p>
  </Section>
</BaseLayout>

<style>
  .accordion {
    --rule: color-mix(in srgb, currentColor 20%, transparent);
    border-block-end: 1px solid var(--rule);
    /* Lets ::details-content animate between 0 and auto where supported. */
    interpolate-size: allow-keywords;
  }

  .accordion > details {
    border-block-start: 1px solid var(--rule);
  }

  .accordion summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    gap: var(--space-s);
    justify-content: space-between;
    /* The default marker, in Firefox and Safari respectively. */
    list-style: none;
    padding-block: var(--space-s);

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      color: var(--color-primary);
    }
  }

  /* A step down from a standalone h3: fifteen rows of --size-step-3 read as
     fifteen headings rather than as one list. The global 20ch cap on headings
     is a measure for a block of prose — in a row with a chevron pinned to the
     far right it just wraps short questions in two for no reason. */
  .accordion h3 {
    font-size: var(--size-step-2);
    max-width: 40ch;
  }

  /* Chevron, drawn from two borders so it needs no asset. */
  .accordion summary::after {
    block-size: 0.5em;
    border-block-end: 2px solid;
    border-inline-end: 2px solid;
    content: "";
    flex: none;
    inline-size: 0.5em;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform var(--transition-base);
  }

  .accordion details[open] summary::after {
    transform: translateY(0.1em) rotate(-135deg);
  }

  .accordion p {
    padding-block-end: var(--space-m);
  }

  /* Height animation. Inert in browsers without ::details-content — they just
     snap open, which is the pre-2024 <details> behaviour. */
  .accordion details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size var(--transition-base),
      content-visibility var(--transition-base);
    transition-behavior: allow-discrete;
  }

  .accordion details[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion summary::after,
    .accordion details::details-content {
      transition: none;
    }
  }
</style>
