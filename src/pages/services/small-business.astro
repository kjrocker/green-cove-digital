---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Card from "../../components/Card.astro";
import Grid from "../../components/Grid.astro";
import SpotBand from "../../components/SpotBand.astro";
import Section from "../../components/Section.astro";
import { SITE, BUSINESS, PERSON } from "../../data/client";
import { PRICING, usd } from "../../data/pricing";

const faqs: { q: string; a: string }[] = [
  {
    q: `What does ${usd(PRICING.monthly)} a month cover?`,
    a: "Design and build of your site (up to five pages to start), hosting, SSL, your domain, security and software updates, and ongoing content changes — new hours, a new service, a photo swap. Email me the change and it's done within a few business days. There is no separate maintenance plan and no hosting bill.",
  },
  {
    q: "When does the first payment happen?",
    a: `When the work starts. The first month's ${usd(PRICING.monthly)} is what starts the work — there's no lump sum up front and no deposit on top of it. From there it's the same ${usd(PRICING.monthly)} every month, while the site is being built and after it's live.`,
  },
  {
    q: "Is there a contract or a minimum term?",
    a: `Yes: twelve monthly payments, starting with the first one. The build takes weeks and nobody pays for it up front, so the first year's payments are what pay for it. That's the trade for $0 down. After the twelve months you're month to month and can cancel with 30 days' notice.`,
  },
  {
    q: "What if I have to cancel during the first year?",
    a: `You still owe the remaining months of the first year — no penalty on top. After month twelve, cancelling costs nothing but 30 days' notice. Either way, your domain, your files and anything you've written on the site stay yours.`,
  },
  {
    q: "Do I keep my website if I cancel?",
    a: "The site itself, no. What you always keep: your domain; every logo, photo and file you sent me; and anything you wrote on the site — if you added a blog, every post is yours. I'll make sure you have all of it and point the domain wherever you tell me. Nothing that belongs to your business is ever held hostage.",
  },
  {
    q: "What if I need more than five pages?",
    a: `Extra pages are a one-time ${usd(PRICING.extraPage)} each — not a monthly increase. If you need something much larger, we can work it out.`,
  },
  {
    q: "What happens after the first year?",
    a: "The price doesn't move and the service doesn't change. Every four years I'll refresh the design so it doesn't go stale — that's included too.",
  },
  {
    q: "How long does it take?",
    a: "Typically two to four weeks from our first call to a live site, depending on how quickly we can get your content together. A simple site with content ready can be faster.",
  },
  {
    q: "What do you need from me?",
    a: "A short call about your business, your logo and any brand colors you have, some photos if you have them (I can source stock if not), and about an hour of your time reviewing drafts. The copy is written for you from our call — you don't need to sit down and write your website.",
  },
  {
    q: "What if I don't like the design?",
    a: "Then we don't launch it. You can watch the build on a private preview link, so there are no surprises, and we keep revising until it's right — I'd rather spend another week on the design than put something live that you don't like.",
  },
  {
    q: "Can I update the site myself?",
    a: "Yes. For simple things such as hours or blog posts I'll include a content editor. Most clients find it faster to just email me the change, and that's included, so it's your call.",
  },
  {
    q: "Will it show up on Google?",
    a: "Every site gets the technical SEO basics: fast load times, mobile-first layout, clean structure, local business markup, and copy written around what your customers search for. That puts you ahead of most small business sites. But nobody can promise a specific ranking — how fast you climb depends on your competition, your reviews, and time.",
  },
  {
    q: "How is this different from Wix or Squarespace?",
    a: `Wix and Squarespace sell you a tool; I sell you a finished, looked-after website. With a builder you pay $20–40 a month and then do the design, the writing, the SEO and every update yourself, on a template thousands of other businesses use. With me it's ${usd(PRICING.monthly)} a month for a custom site that's designed, written and maintained for you, built to load faster and rank better than a template. If you enjoy building websites, a builder is cheaper. If you'd rather spend that time on your business, this is what it's for.`,
  },
  {
    q: "Where is the site hosted, and how secure is it?",
    a: "On professionally managed hosting — not a shared server or a computer in my office. Sites without a content editor are served as plain pre-built pages, so there is almost nothing to break into; sites with one are kept patched as part of the subscription. Either way, SSL and backups are handled and you never see a hosting bill.",
  },
  {
    q: "Do you build online stores?",
    a: "Small ones, yes — a coffee roaster selling a dozen coffees and some merch, a shop with a short list of products, a practice taking payment for a service. A handful of products with checkout is squarely in scope. A large catalog with inventory, shipping rules and thousands of SKUs is a different kind of project, and not one I take on.",
  },
  {
    q: "Do you work with businesses in my area?",
    a: "Yes — anywhere in the US. Everything happens over calls, email and a private preview link, so it works the same wherever you are. I never meet most of my clients in person, and it has never mattered.",
  },
  {
    q: "What if something happens to you?",
    a: "Fair question to ask a one-person business. Your site runs on professionally managed hosting, not on a computer in my house, so it doesn't go offline because I'm unreachable. Your domain is in your name and your content is yours, so if I ever wound the business down you would get a full export and any web designer could rebuild from it. You are never locked out of your own site.",
  },
  {
    q: "Do you offer other languages?",
    a: "Sometimes. For Spanish and some other languages I bring in a professional translator (not machine translation) for an extra fee based on how much content there is. Ask, and I'll tell you whether I can do yours.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      name: "Small Business Website Design & Development",
      serviceType: "Web Design",
      provider: {
        "@type": "Organization",
        name: BUSINESS.name,
        legalName: BUSINESS.legalName,
        url: SITE.url,
      },
      description: `Custom small business websites for ${usd(PRICING.monthly)}/month with zero down payment. Includes design, hosting, domain, maintenance, content updates and local SEO. Twelve-month minimum, then month-to-month with 30 days' notice.`,
      areaServed: { "@type": "Country", name: BUSINESS.areaServed },
      offers: {
        "@type": "Offer",
        price: String(PRICING.monthly),
        priceCurrency: "USD",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: String(PRICING.monthly),
          priceCurrency: "USD",
          unitText: "month",
        },
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
  ],
};
---

<BaseLayout
  title={`Website Subscription Pricing — ${usd(PRICING.monthly)}/mo, $0 Down, No Build Fee | ${SITE.title}`}
  path="/services/small-business"
  ogTitle={`Website Subscription Pricing: ${usd(PRICING.monthly)}/Month, $0 Down | ${SITE.title}`}
  description={`What a subscription website costs and what's included: ${usd(PRICING.monthly)}/month, $0 down, no up-front build fee. Custom design, hosting, domain, content updates and local SEO for plumbers, coffee roasters, restaurants, shops and practices anywhere in the US.`}
  ogDescription={`Custom small business websites for ${usd(PRICING.monthly)}/month with zero down. Design, hosting, updates and local SEO included. Twelve-month minimum, then month to month — your domain and content are always yours.`}
  jsonLd={jsonLd}
>
  <Hero slot="header" title={`Website Subscription Pricing: ${usd(PRICING.monthly)} a Month, $0 Down`}>
    <p class="big">
      One monthly subscription, no up-front build fee. What it costs and
      what's included.
    </p>
    <div class="cluster">
      <a href="/contact">Book a Call</a>
      <a href="#faq">Read the FAQ</a>
    </div>
  </Hero>

  <Section>
    <h2>What a Subscription Website Costs</h2>
    <Grid layout="50-50">
      <div class="flow">
        <h3>{usd(PRICING.monthly)}/Month. $0 Down.</h3>
        <p>
          One predictable monthly payment that covers design, hosting,
          maintenance, and updates. Squarespace charges $20–40 a month and makes
          you build it. I build something custom for {usd(PRICING.monthly)} and keep looking after it.
        </p>
        <p>
          <strong>What $0 down means:</strong> the first month's {usd(PRICING.monthly)} is what
          starts the work — there's no lump sum up front and no deposit on top
          of it.
        </p>
        <p>
          <strong>Twelve-month minimum.</strong> After the first year you're
          month to month — cancel with 30 days' notice. The
          <a href="#faq">FAQ</a> has the details.
        </p>
        <p>
          <strong>Typical turnaround:</strong> 2–4 weeks from our first conversation
          to a live site, depending on content and scope. First time?
          <a href="/#how-it-works">See how it works</a>.
        </p>
      </div>
      <Card>
        <h3>What's Included</h3>
        <ul class="flow" data-flow="sm">
          <li>Custom design — no templates</li>
          <li>Up to five pages to start</li>
          <li>Copy written for you, tuned for search</li>
          <li>Domain name registration and management</li>
          <li>Mobile-first, responsive design</li>
          <li>Optional content editor for blogs, announcements, etc.</li>
          <li>Local SEO groundwork: schema, speed, structure, keywords</li>
          <li>Hosting, SSL, and backups</li>
          <li>Ongoing content changes — just email me</li>
          <li>Security and software updates</li>
        </ul>
      </Card>
    </Grid>
  </Section>

  <SpotBand>
    <h2>Why a Monthly Subscription Instead of a Big Invoice?</h2>
    <p>
      Because a website is never done. The menu changes, the summer hours start,
      you add a service, a staff photo is three years old. Each fix takes
      five minutes, and nobody files a ticket or pays a minimum fee for five
      minutes. So it doesn't get done, and a year
      later your site is quietly wrong about your own business.
    </p>
    <p>
      A subscription puts those small fixes inside the price, so they get
      done. After the first year you only keep paying if the site is still
      fast, secure and online — which is how I'd want it too. And it turns a
      $5,000 decision into a {usd(PRICING.monthly)} one you can make this week.
    </p>
    <p>
      It's also why there's a twelve-month minimum. The build takes weeks and
      nobody pays for it up front, so the first year's payments are what pay
      for it. That's the trade for $0 down — I'd rather ask you for twelve
      months than for a few thousand dollars on day one.
    </p>
  </SpotBand>

  <Section ornament>
    <h2>Built for Performance</h2>
    <p>
      Slow sites lose visitors and rank lower on Google. Mine load in under a
      second on a phone — images optimized, no unnecessary code, fast hosting.
    </p>
    <p>
      This site scores 100 on Google Lighthouse, and every site I build has to
      match it. Curious how your current site does? Run it through Google's free
      <a href="https://pagespeed.web.dev/">PageSpeed Insights</a> — then run this
      one.
    </p>
  </Section>

  <Section>
    <h2>Websites for Trades, Roasters, Shops and Practices</h2>
    <Grid as="ul" layout="50-50" role="list">
      <Card as="li">
        <h3>Plumbers, Electricians and Contractors</h3>
        <p>
          A mobile-friendly site with clear contact info, your service areas,
          and the SEO work needed to show up when someone searches "plumber
          near me" — or landscaper, HVAC, or general contractor.
        </p>
      </Card>
      <Card as="li">
        <h3>Boutiques and Small Shops</h3>
        <p>
          Product showcases for boutiques, specialty stores and makers, simple
          checkout for a handful of products if you need it, and a site that
          works on the phones and tablets where most browsing happens.
        </p>
      </Card>
      <Card as="li">
        <h3>Lawyers, Accountants and Therapists</h3>
        <p>
          Your practice areas, who you are, and how to get in touch, laid out
          so a first-time client knows within a minute whether you're the
          right call. Works for law firms, accountants, therapists and
          consultants; online booking can be added if you use it.
        </p>
      </Card>
      <Card as="li">
        <h3>Coffee Roasters, Cafés and Restaurants</h3>
        <p>
          A roaster's site with a small online store built in — a dozen
          coffees, merch, checkout, done. Cafés and restaurants get
          easy-to-update menus, hours, location and a link to your reservation
          system if you use one. Update specials yourself — or email me and
          I'll do it.
        </p>
      </Card>
    </Grid>
  </Section>

  <SpotBand>
    <h2>What You Keep</h2>
    <p>
      Your domain, every file you send me, and anything you write on the
      site — a blog, announcements — stays yours, always. Unlike Squarespace
      or Wix, none of it is tied up in a large corporation that can raise
      prices, restrict features, or change its policies overnight.
    </p>
    <p>
      The site itself — design and code — is mine, hosted and looked after
      for as long as you're a client. If you leave, your domain, your files
      and your writing go with you, and the site comes down.
    </p>
  </SpotBand>

  <Section id="faq">
    <h2 style="max-width:40ch;">Frequently Asked Questions</h2>
    <div class="accordion">
      {
        faqs.map(({ q, a }) => (
          <details>
            <summary>
              <h3>{q}</h3>
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
    <p style="max-width:65ch;">
      Something I didn't cover? <a href="/contact">Ask {PERSON.firstName}</a>
      — I reply within one business day.
    </p>
  </Section>

  <Section>
    <h2>Ready to Get Started?</h2>
    <p>
      Tell me about your business and I'll let you know what a site would look
      like and how long it'll take. Nothing to sign and nothing to pay for the
      call.
    </p>
    <p>
      <a href="/contact">Book a Call</a>
    </p>
  </Section>
</BaseLayout>

<style>
  .accordion {
    --rule: color-mix(in srgb, currentColor 20%, transparent);
    border-block-end: 1px solid var(--rule);
    /* Lets ::details-content animate between 0 and auto where supported. */
    interpolate-size: allow-keywords;
  }

  .accordion > details {
    border-block-start: 1px solid var(--rule);
  }

  .accordion summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    gap: var(--space-s);
    justify-content: space-between;
    /* The default marker, in Firefox and Safari respectively. */
    list-style: none;
    padding-block: var(--space-s);

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      color: var(--color-primary);
    }
  }

  /* A step down from a standalone h3: fifteen rows of --size-step-3 read as
     fifteen headings rather than as one list. The global 20ch cap on headings
     is a measure for a block of prose — in a row with a chevron pinned to the
     far right it just wraps short questions in two for no reason. */
  .accordion h3 {
    font-size: var(--size-step-2);
    max-width: 40ch;
  }

  /* Chevron, drawn from two borders so it needs no asset. */
  .accordion summary::after {
    block-size: 0.5em;
    border-block-end: 2px solid;
    border-inline-end: 2px solid;
    content: "";
    flex: none;
    inline-size: 0.5em;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform var(--transition-base);
  }

  .accordion details[open] summary::after {
    transform: translateY(0.1em) rotate(-135deg);
  }

  .accordion p {
    padding-block-end: var(--space-m);
  }

  /* Height animation. Inert in browsers without ::details-content — they just
     snap open, which is the pre-2024 <details> behaviour. */
  .accordion details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size var(--transition-base),
      content-visibility var(--transition-base);
    transition-behavior: allow-discrete;
  }

  .accordion details[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion summary::after,
    .accordion details::details-content {
      transition: none;
    }
  }
</style>
