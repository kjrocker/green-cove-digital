---
import Curve from "../../components/Curve.astro";
import Footer from "../../components/Footer.astro";
import Starfield from "../../components/Starfield.astro";
import "../../css/reset.css";
import "../../css/global.css";
import "../../css/index.css";
import Navigation from "../../components/Navigation.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href="https://starburstdigital.com/services/small-business" />
    <meta
      name="description"
      content="Custom small business websites starting at $150/month with zero down payment. Includes hosting, SEO, mobile-friendly design, and ongoing maintenance. Cancel anytime."
    />
    <meta
      property="og:title"
      content="Small Business Website Pricing & Features | Starburst Digital"
    />
    <meta
      property="og:description"
      content="Custom small business websites starting at $150/month with zero down payment. Includes hosting, SEO, mobile-friendly design, and ongoing maintenance."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content="Small Business Website Pricing & Features | Starburst Digital"
    />
    <meta
      name="twitter:description"
      content="Custom small business websites starting at $150/month with zero down payment. Includes hosting, SEO, mobile-friendly design, and ongoing maintenance."
    />
    <title>Small Business Website Pricing & Features - Starburst Digital</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        name: "Small Business Website Development",
        provider: {
          "@type": "LocalBusiness",
          name: "Starburst Digital",
          address: {
            "@type": "PostalAddress",
            addressLocality: "Charlotte",
            addressRegion: "NC",
            addressCountry: "US",
          },
        },
        description:
          "Custom small business websites starting at $150/month with zero down payment. Includes hosting, SEO, mobile-friendly design, and ongoing maintenance.",
        areaServed: {
          "@type": "Country",
          name: "US",
        },
        offers: {
          "@type": "Offer",
          price: "150",
          priceCurrency: "USD",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: "150",
            priceCurrency: "USD",
            unitText: "month",
          },
        },
      })}
    />
  </head>
  <body>
    <Starfield>
      <header class="flow">
        <p class="wrapper mt-m-l">
          <a href="/" class="big-brand">Starburst Digital</a>
        </p>
        <nav style="padding-top:1px;padding-bottom:1px;">
          <Navigation />
        </nav>
      </header>
      <div class="section__inner">
        <div class="wrapper flow region">
          <h1>Small Business Websites</h1>
          <p class="big">
            A custom website designed for your business — built by hand,
            optimized for local search, and fast enough to score 100 on
            Google Lighthouse. Serving small businesses in Charlotte, NC
            and everywhere else.
          </p>
        </div>
      </div>
    </Starfield>

    <main>
      <article class="flow region wrapper">
        <h2>Pricing That Makes Sense</h2>
        <div class="grid" data-layout="50-50">
          <div class="flow">
            <h3>$150/Month</h3>
            <p>
              One predictable monthly payment that covers design, hosting,
              maintenance, and updates. Squarespace charges $33/month for a
              template — I build something custom for $150.
            </p>
            <p>
              <strong>Zero down payment.</strong> Pay as you grow. Cancel anytime
              with 30 days notice.
            </p>
            <p>
              <strong>Typical turnaround:</strong> 2–4 weeks from our first
              conversation to a live site, depending on content and scope.
            </p>
          </div>
          <div class="card flow">
            <h3>What's Included</h3>
            <ul class="flow" data-flow="sm">
              <li>Custom branded website design</li>
              <li>Domain name management</li>
              <li>Responsive mobile-friendly design</li>
              <li>Content management (you can update text and images yourself)</li>
              <li>Basic SEO optimization</li>
              <li>Hosting and maintenance</li>
              <li>Regular updates and security patches</li>
              <li>Translation services (available for an additional fee)</li>
            </ul>
          </div>
        </div>
      </article>

      <div class="section spot-color-secondary">
        <Curve />
        <div class="section__inner">
          <article class="flow region wrapper">
            <h2>Built for Performance</h2>
            <p>
              Every extra second of load time costs you visitors and sales.
              My sites load in under a second — I optimize images, strip out
              unnecessary code, and use modern hosting infrastructure to keep
              things fast.
            </p>
            <p>
              Fast sites rank higher on Google and convert better. This site
              scores 100 on Google Lighthouse, and yours will too.
            </p>
          </article>
        </div>
        <Curve />
      </div>

      <article class="flow region wrapper">
        <h2>Perfect For</h2>
        <ul class="grid" data-layout="50-50" role="list">
          <li class="card flow">
            <h3>Local Services</h3>
            <p>
              Plumbers, electricians, landscapers, contractors. A mobile-friendly
              site with clear contact info, service areas, and the SEO work
              needed to show up when someone searches "plumber near me."
            </p>
          </li>
          <li class="card flow">
            <h3>Retail & E-commerce</h3>
            <p>
              Small shops and boutiques. Product showcases, payment processing
              if you need it, and a site that works on phones and tablets where
              most shopping happens.
            </p>
          </li>
          <li class="card flow">
            <h3>Professional Services</h3>
            <p>
              Consultants, lawyers, accountants. A site that establishes
              credibility, explains your services clearly, and makes it easy
              for clients to schedule a consultation.
            </p>
          </li>
          <li class="card flow">
            <h3>Restaurants & Hospitality</h3>
            <p>
              Easy-to-update menus, hours, location info, and reservation
              integration if needed. Update specials yourself without calling
              a developer.
            </p>
          </li>
        </ul>
      </article>

      <div class="section spot-color-primary">
        <Curve />
        <div class="section__inner">
          <article class="flow region wrapper">
            <h2>No Vendor Lock-In</h2>
            <p>
              Your content, your domain, your customer data—it all stays yours.
              Unlike Squarespace or Wix, you're not trapped in a proprietary
              platform that controls your business.
            </p>
            <p>
              I build sites on open web standards, which means your content is
              portable and you're not subject to arbitrary price hikes, forced
              feature restrictions, or platform policy changes that could hurt
              your business overnight.
            </p>
            <p>
              If your needs change or you want to move in a different direction,
              you won't have to rebuild from scratch. Your digital presence is
              yours to control.
            </p>
          </article>
        </div>
        <Curve />
      </div>

      <article class="flow region wrapper">
        <h2>Ready to Get Started?</h2>
        <p>
          Tell me about your business and I'll let you know what a site
          would look like and how long it'll take. No commitment.
        </p>
        <p>
          <a href="/contact">Start Your Website — $0 Down</a>
        </p>
      </article>
    </main>

    <Footer />
  </body>
</html>
