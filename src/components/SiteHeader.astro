---
import Navigation from "./Navigation.astro";
import { SITE } from "../data/client";

interface Props {
  /**
   * The home page renders the brand at --size-step-6 rather than
   * --size-step-4. Purely a size variant — the markup is the same link on
   * every page, which is what keeps index down to a single <h1>.
   */
  brandSize?: "default" | "hero";
}

const { brandSize = "default" } = Astro.props;
---

<header class="flow">
  <p
    class:list={[
      "wrapper",
      brandSize === "hero" ? "ml-md-sm mt-l-xl brand-hero" : "mt-m-l",
    ]}
  >
    {/* prettier-ignore */}
    <a href="/" class="big-brand">{SITE.title}</a>
  </p>
  <Navigation />
</header>
