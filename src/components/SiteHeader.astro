---
import Navigation from "./Navigation.astro";
import { SITE } from "../data/client";

interface Props {
  /**
   * "link" is the brand treatment on every page except the home page, which
   * uses an <h1>. See docs/known-issues.md — index ends up with two <h1>s.
   */
  brandAs?: "link" | "h1";
}

const { brandAs = "link" } = Astro.props;
---

<header class="flow">
  {
    brandAs === "h1" ? (
      <h1 class="wrapper ml-md-sm mt-l-xl big">{SITE.title}</h1>
    ) : (
      <p class="wrapper mt-m-l">
        {/* prettier-ignore */}
        <a href="/" class="big-brand">{SITE.title}</a>
      </p>
    )
  }
  <Navigation />
</header>
