---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  as?: "article" | "section" | "div";
}

const { as: Tag = "article", class: className, ...rest } = Astro.props;
---

<Tag class:list={["flow", "region", "wrapper", className]} {...rest}>
  <slot />
</Tag>
