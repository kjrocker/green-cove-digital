---
import Cove from "./Cove.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  /** The page's <h1>. Always plain text, always exactly one per page. */
  title: string;
  brandAs?: "link" | "h1";
  wrapNav?: boolean;
}

const { title, brandAs, wrapNav } = Astro.props;
---

<Cove>
  <SiteHeader brandAs={brandAs} wrapNav={wrapNav} />
  <div class="section__inner">
    <div class="wrapper flow region">
      <h1>{title}</h1>
      <slot />
    </div>
  </div>
</Cove>
