---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  as?: "ul" | "ol" | "div";
  layout?: "50-50";
}

const { as: Tag = "div", layout, class: className, ...rest } = Astro.props;
---

<Tag class:list={["grid", className]} data-layout={layout} {...rest}>
  <slot />
</Tag>
