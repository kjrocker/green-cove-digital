---
import Cove from "./Cove.astro";
import NavList from "./NavList.astro";
import EmailLink from "./EmailLink.astro";
import { BUSINESS } from "../data/client";
---

<Cove top static bottom={false}>
  <div class="section__inner">
    <footer class="wrapper grid region" data-layout="50-50">
      <div class="flow" data-flow="sm">
        <p>
          &copy; {new Date().getFullYear()} {BUSINESS.name}. All rights reserved.
        </p>
        <p>
          Email: <EmailLink />
        </p>
        <p>Working remotely with small businesses across the US.</p>
      </div>
      <nav>
        <NavList />
      </nav>
    </footer>
  </div>
</Cove>
