---
import Cove from "./Cove.astro";
import { BUSINESS } from "../data/client";
---

<Cove top static bottom={false}>
  <div class="section__inner">
    <footer class="wrapper grid region" data-layout="50-50">
      <div class="flow" data-flow="sm">
        <p>
          &copy; {new Date().getFullYear()} {BUSINESS.name}. All rights reserved.
        </p>
        <p>
          Email: <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
        </p>
        <!-- <p>Based in Charlotte, NC — serving small businesses everywhere.</p> -->
      </div>
      <nav>
        <ul class="cluster" role="list">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/services/small-business">For Small Businesses</a></li>
          <li><a href="/services/consulting">For Software Teams</a></li>
        </ul>
      </nav>
    </footer>
  </div>
</Cove>
