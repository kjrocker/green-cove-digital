---
interface Props {
  static?: boolean;
  top?: boolean;
  bottom?: boolean;
}
const { static: isStatic = false, top = false, bottom = true } = Astro.props;

// Cove draws no per-instance geometry: every tile it uses is a named constant
// in the `:root` block that <OrnamentTiles> emits, so this component carries no
// `define:vars` and its stylesheet bundles like any other.
---

<div
  id="background-wrapper"
  class="section"
  data-static={isStatic || undefined}
  data-top={top || undefined}
  data-bottom={bottom || undefined}
>
  <div class="motes motes-small"></div>
  <div class="motes motes-big"></div>
  <div class="wave wave-1"></div>
  <div class="wave wave-2"></div>
  <div class="wave wave-3"></div>
  <div class="wave wave-4"></div>
  <slot />
</div>

<style>
  #background-wrapper {
    --spot-color: transparent;
    overflow: hidden;
    position: relative;
    background:
      radial-gradient(
        ellipse 90% 60% at 80% -10%,
        hsla(160, 60%, 50%, 0.16) 0%,
        transparent 65%
      ),
      radial-gradient(
        ellipse at 20% 100%,
        hsl(168, 50%, 16%) 0%,
        hsl(172, 55%, 11%) 35%,
        hsl(178, 60%, 6%) 65%,
        hsl(186, 70%, 3%) 100%
      );
  }

  #background-wrapper[data-bottom] {
    padding-bottom: 3.5em;
  }

  #background-wrapper[data-bottom]::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: calc(3.5em + 3px);
    background-image: var(--o-cove-edge);
    background-size: 100% 100%;
    pointer-events: none;
    z-index: 2;
  }

  #background-wrapper[data-top] {
    padding-top: 3.5em;
  }

  #background-wrapper[data-top]::before {
    content: "";
    position: absolute;
    top: -2px;
    left: 0;
    width: 100%;
    height: calc(3.5em + 3px);
    background-image: var(--o-cove-edge);
    background-size: 100% 100%;
    pointer-events: none;
    z-index: 2;
    transform: rotate(180deg);
  }

  /* Layers are one tile wider than the section; translating by exactly one
     tile width and looping is seamless because the tile repeats. */
  .wave {
    position: absolute;
    bottom: 0;
    left: 0;
    width: calc(100% + var(--tilePx));
    background-repeat: repeat-x;
    background-position: left bottom;
    pointer-events: none;
    animation: drift linear infinite;
    @media (prefers-reduced-motion: reduce) {
      animation: none;
    }
  }

  .wave-1 {
    height: 260px;
    background-image: var(--o-cove-wave-1);
    opacity: 0.07;
    animation-duration: 110s;
  }

  .wave-2 {
    height: 190px;
    background-image: var(--o-cove-wave-2);
    opacity: 0.1;
    animation-duration: 75s;
    animation-direction: reverse;
  }

  .wave-3 {
    height: 130px;
    background-image: var(--o-cove-wave-3);
    opacity: 0.14;
    animation-duration: 50s;
  }

  .wave-4 {
    height: 80px;
    background-image: var(--o-cove-wave-4);
    opacity: 0.2;
    animation-duration: 34s;
    animation-direction: reverse;
  }

  .motes {
    position: absolute;
    inset: 0;
    width: calc(100% + var(--fieldPx));
    background-repeat: repeat;
    background-size: var(--fieldPx) var(--fieldPx);
    pointer-events: none;
    animation: drift linear infinite;
    @media (prefers-reduced-motion: reduce) {
      animation: none;
    }
  }

  .motes-small {
    background-image: var(--o-cove-motes-small);
    opacity: 0.35;
    animation-duration: 170s;
    animation-name: drift-field;
  }

  .motes-big {
    background-image: var(--o-cove-motes-big);
    opacity: 0.25;
    animation-duration: 120s;
    animation-name: drift-field;
    animation-direction: reverse;
  }

  #background-wrapper[data-static] :is(.wave, .motes) {
    animation: none;
  }

  @keyframes drift {
    to {
      transform: translateX(calc(-1 * var(--tilePx)));
    }
  }

  @keyframes drift-field {
    to {
      transform: translateX(calc(-1 * var(--fieldPx)));
    }
  }
</style>
