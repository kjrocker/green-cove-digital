---
import {
  type Tone,
  type Edge,
  nextSeed,
  waveTileVar,
  bubbleVariant,
} from "../lib/ornaments";

interface Props {
  /** Wave silhouette hugging one edge of the host. */
  waves?: boolean;
  /** Field of slowly rising circles. */
  bubbles?: boolean;
  /** Which edge the waves hug. */
  edge?: Edge;
  /** Ornament tint: `light` on dark surfaces, `dark` on light ones. */
  tone?: Tone;
  /** Pin the variant. Defaults to a fresh seed per instance. */
  seed?: number;
  /** Freeze every layer, matching Cove's escape hatch. */
  static?: boolean;
}

const {
  waves = false,
  bubbles = true,
  edge = "top",
  tone = "light",
  seed = nextSeed(),
  static: isStatic = false,
} = Astro.props;

// The tiles themselves live in one `:root` block emitted by <OrnamentTiles>;
// all an instance carries is which one to point at, plus the crop and mirror
// that keep it from looking like its neighbours.
const variant = bubbles ? bubbleVariant(tone, seed) : null;
---

<div class="drift" aria-hidden="true" data-static={isStatic || undefined}>
  {
    waves && (
      <div
        class="drift__wave"
        data-edge={edge}
        style={`--drift-wave:var(${waveTileVar(tone, edge)})`}
      />
    )
  }
  {
    variant && (
      <div
        class="drift__bubbles"
        data-flip={variant.flip === -1 || undefined}
        style={`--drift-tile:var(${variant.tileVar});--drift-crop:${variant.offset};--drift-flip:${variant.flip}`}
      />
    )
  }
</div>

<style>
  /* Sits between the host's own background and its in-flow content: the host
     isolates, so z-index: -1 paints above the background but below the text. */
  .drift {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  /* One tile wider than the host; translating by exactly one tile width and
     looping is seamless because the tile repeats. */
  .drift__wave {
    position: absolute;
    left: 0;
    width: calc(100% + var(--tilePx));
    height: var(--waveHeightPx);
    background-image: var(--drift-wave);
    background-repeat: repeat-x;
    opacity: var(--drift-wave-opacity, 0.1);
    animation: drift-x linear infinite;
    animation-duration: var(--drift-wave-time, 180s);

    /* The silhouette is solid up to the anchored edge, which would read as a
       straight rule where the layer starts. Fade that edge out instead. */
    &[data-edge="top"] {
      top: 0;
      background-position: left top;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%);
      mask-image: linear-gradient(to bottom, transparent, #000 45%);
    }

    &[data-edge="bottom"] {
      bottom: 0;
      background-position: left bottom;
      -webkit-mask-image: linear-gradient(to top, transparent, #000 45%);
      mask-image: linear-gradient(to top, transparent, #000 45%);
    }

    @media (prefers-reduced-motion: reduce) {
      animation: none;
    }
  }

  /* Overhangs one full field on the two sides the field arrives from, so
     drifting up-and-left by exactly one field keeps the host covered for the
     whole cycle.

     This used to overhang a full field on all FOUR sides, which made the layer
     2 x FIELD wider and taller than its host — on a phone, a 360x320 card grew
     a 3160x3120 composited layer. That is many times the size Firefox will
     prerender a transform animation at, so the animation dropped to the main
     thread and repainted during scroll. See docs/known-issues.md. */
  .drift__bubbles {
    position: absolute;
    inset: 0 calc(-1 * var(--fieldPx)) calc(-1 * var(--fieldPx)) 0;
    background-image: var(--drift-tile);
    background-repeat: repeat;
    background-size: var(--fieldPx) var(--fieldPx);
    /* Crops a different part of the shared tile per instance. Free: it changes
       neither the surface nor the layer's size. */
    background-position: var(--drift-crop);
    opacity: var(--drift-bubble-opacity, 0.12);
    animation: drift-diagonal linear infinite;
    animation-duration: var(--drift-bubble-time, 110s);

    /* A mirrored field drifts up-and-RIGHT, so its field of travel margin has
       to sit on the left instead. */
    &[data-flip] {
      inset: 0 0 calc(-1 * var(--fieldPx)) calc(-1 * var(--fieldPx));
    }

    @media (prefers-reduced-motion: reduce) {
      animation: none;
    }
  }

  .drift[data-static] :is(.drift__wave, .drift__bubbles) {
    animation: none;
  }

  @keyframes drift-x {
    to {
      transform: translateX(calc(-1 * var(--tilePx)));
    }
  }

  /* The mirror has to live INSIDE the keyframe. This animates `transform`, so a
     base `transform: scaleX(-1)` on the element would simply be overridden the
     moment the animation started. The individual `scale:` property is no good
     either: it composes as translate -> rotate -> scale, which applies the
     translate in the parent's coordinate space rather than the mirrored one, so
     the step would stop landing on the tile lattice and the field would jump
     once per cycle instead of looping seamlessly. */
  @keyframes drift-diagonal {
    from {
      transform: scaleX(var(--drift-flip)) translate(0, 0);
    }
    to {
      transform: scaleX(var(--drift-flip))
        translate(calc(-1 * var(--fieldPx)), calc(-1 * var(--fieldPx)));
    }
  }
</style>
